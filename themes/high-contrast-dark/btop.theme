# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a0a0a"

# Main text color
theme[main_fg]="#e8e8e8"

# Title color for boxes
theme[title]="#e8e8e8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7ab8ff"

# Background color of selected item in processes box
theme[selected_bg]="#2e2e2e"

# Foreground color of selected item in processes box
theme[selected_fg]="#7ab8ff"

# Color of inactive/disabled text
theme[inactive_fg]="#9e9e9e"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ffd7d0"

# Background color of the percentage meters
theme[meter_bg]="#2e2e2e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ffd7d0"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c9a3ff" #Mauve
theme[mem_box]="#5ee06a" #Green
theme[net_box]="#ff8f8f" #Maroon
theme[proc_box]="#7ab8ff" #Blue

# Box divider line and small boxes line color
theme[div_line]="#9b9b9b"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#5ee06a"
theme[temp_mid]="#ffd93d"
theme[temp_end]="#ff6b6b"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#4fe0c8"
theme[cpu_mid]="#4cc8f0"
theme[cpu_end]="#b9c4ff"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#c9a3ff"
theme[free_mid]="#b9c4ff"
theme[free_end]="#7ab8ff"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#4cc8f0"
theme[cached_mid]="#7ab8ff"
theme[cached_end]="#b9c4ff"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#ffb060"
theme[available_mid]="#ff8f8f"
theme[available_end]="#ff6b6b"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#5ee06a"
theme[used_mid]="#4fe0c8"
theme[used_end]="#5fd7ff"

# Download graph colors (Peach -> Red)
theme[download_start]="#ffb060"
theme[download_mid]="#ff8f8f"
theme[download_end]="#ff6b6b"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#5ee06a"
theme[upload_mid]="#4fe0c8"
theme[upload_end]="#5fd7ff"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#4cc8f0"
theme[process_mid]="#b9c4ff"
theme[process_end]="#c9a3ff"