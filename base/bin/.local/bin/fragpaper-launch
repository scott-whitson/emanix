#!/usr/bin/env bash
# fragpaper-launch — launches fragpaper with the current theme's bg + palette.
# Reads ~/.config/dotfiles/active-theme, then sources
# ~/dotfiles/themes/<active>/fragpaper.conf for BG_COLOR and PALETTE.
# Uses local ~/projects/fragpaper shader repo directly.
# Falls back to Catppuccin Mocha defaults if no active theme is set.

set -u

if [[ -n "${DOTFILES:-}" ]]; then
    DOTFILES="$DOTFILES"
else
    for candidate in "$HOME/projects/dotfiles" "$HOME/dotfiles"; do
        if [[ -d "$candidate/themes" ]]; then
            DOTFILES="$candidate"
            break
        fi
    done
    DOTFILES="${DOTFILES:-$HOME/projects/dotfiles}"
fi
ACTIVE_THEME_FILE="$HOME/.config/dotfiles/active-theme"

BG_COLOR="#1e1e2e"
PALETTE="dark"

if [[ -f "$ACTIVE_THEME_FILE" ]]; then
    active=$(<"$ACTIVE_THEME_FILE")
    conf="$DOTFILES/themes/$active/fragpaper.conf"
    if [[ -f "$conf" ]]; then
        # shellcheck source=/dev/null
        . "$conf"
    fi
fi

FRAGPAPER_BIN="${FRAGPAPER_BIN:-$HOME/.local/opt/fragpaper/bin/fragpaper}"
FRAGPAPER_SRC="${FRAGPAPER_SRC:-}"
if [[ -z "$FRAGPAPER_SRC" ]]; then
    for candidate in "$HOME/.local/share/fragpaper" "$HOME/projects/fragpaper"; do
        if [[ -d "$candidate" ]]; then
            FRAGPAPER_SRC="$candidate"
            break
        fi
    done
    FRAGPAPER_SRC="${FRAGPAPER_SRC:-$HOME/.local/share/fragpaper}"
fi
SHADERS_DIR="${FRAGPAPER_SHADERS_DIR:-$FRAGPAPER_SRC/shaders}"

if [[ ! -r "$SHADERS_DIR/attractors.vert" ]] || [[ ! -r "$SHADERS_DIR/attractors.frag" ]]; then
    echo "fragpaper-launch: shader files missing in $SHADERS_DIR" >&2
    exit 1
fi

if [[ -x "$FRAGPAPER_BIN" ]]; then
    exec env RUST_LOG=info "$FRAGPAPER_BIN" \
        --bg-color "$BG_COLOR" \
        --palette "$PALETTE" \
        "$SHADERS_DIR/attractors.vert" \
        "$SHADERS_DIR/attractors.frag"
fi

if command -v fragpaper >/dev/null 2>&1; then
    exec env RUST_LOG=info fragpaper \
        --bg-color "$BG_COLOR" \
        --palette "$PALETTE" \
        "$SHADERS_DIR/attractors.vert" \
        "$SHADERS_DIR/attractors.frag"
fi

if [[ -d "$FRAGPAPER_SRC/.git" ]] && command -v cargo >/dev/null 2>&1; then
    exec env RUST_LOG=info cargo run --quiet --release --locked --manifest-path "$FRAGPAPER_SRC/Cargo.toml" -- \
        --bg-color "$BG_COLOR" \
        --palette "$PALETTE" \
        "$SHADERS_DIR/attractors.vert" \
        "$SHADERS_DIR/attractors.frag"
fi

echo "fragpaper-launch: fragpaper binary not found at $FRAGPAPER_BIN and cargo fallback unavailable" >&2
exit 1
