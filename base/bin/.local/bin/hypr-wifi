#!/usr/bin/env bash
# WiFi connection helper — nmcli + fzf inside ghostty

if ! command -v nmcli &>/dev/null || ! command -v fzf &>/dev/null; then
  notify-send "hypr-wifi" "nmcli or fzf not found" -u critical
  exit 1
fi

nmcli device wifi rescan 2>/dev/null

selected=$(nmcli --terse --fields "SSID,BARS,SECURITY,IN-USE" device wifi list \
  | grep -v "^:" \
  | sed 's/:/\t/g' \
  | fzf --height 100% \
        --reverse \
        --border rounded \
        --margin=1,2 \
        --header "Select WiFi (ESC to quit)" \
        --info inline \
        --tabstop=20 \
        --color="bg+:-1,bg:-1,hl:3,fg:7,header:3,info:4,pointer:3,marker:3,prompt:3")

[[ -z "$selected" ]] && exit 0

ssid=$(echo "$selected" | cut -f1)

if nmcli connection show | grep -qF "$ssid"; then
  nmcli connection up "$ssid" --ask
else
  echo "New network detected: $ssid"
  read -rs -p "Enter password: " password
  echo
  nmcli device wifi connect "$ssid" password "$password"
fi

echo
echo "Press Enter to close..."
read