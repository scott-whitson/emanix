#!/usr/bin/env bash
# Hyprland cheatsheet — rendered as PNG via cairo, displayed in mpv

set -euo pipefail

src="$HOME/docs/vault/Whitsgrove/Hyprland Cheatsheet.md"
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
png_file="$cache/hypr-cheatsheet.png"

[[ ! -f "$src" ]] && { notify-send "hypr-cheatsheet" "Source missing: $src"; exit 1; }

python3 - <<'PYEOF' "$src" "$png_file"
import sys, re, math, cairo

# ── Parse cheatsheet ──────────────────────────────────────────────
with open(sys.argv[1]) as f:
    lines = f.readlines()

sections = []
cur_name = None
cur_items = []
for line in lines:
    s = line.strip()
    m = re.match(r'^##\s+(.+)$', s)
    if m:
        if cur_name is not None:
            sections.append((cur_name, cur_items))
        cur_name = m.group(1)
        cur_items = []
        continue
    bm = re.match(r'^[-*+]\s+`([^`]+)`\s*[—–-]\s*(.+)$', s)
    if bm and cur_name is not None:
        cur_items.append((bm.group(1), bm.group(2)))
if cur_name is not None:
    sections.append((cur_name, cur_items))

sections.append(("Tools", [
    ("Super + C", "Quick calculator (fuzzel + qalc)"),
    ("Super + I", "WiFi connection helper (nmcli + fzf)"),
    ("Super + N", "Phoenix NY weather + satellite/radar"),
    ("Super + U", "OpenRouter cost last 7 days"),
    ("Super + Shift + /", "This cheatsheet"),
]))

# ── Layout ────────────────────────────────────────────────────────
W, H = 960, 720
surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
cr = cairo.Context(surface)
cr.set_source_rgb(30/255, 30/255, 46/255)
cr.paint()

GREEN  = (166/255, 227/255, 161/255)
BLUE   = (137/255, 180/255, 250/255)
ORANGE = (250/255, 179/255, 135/255)
TEXT   = (205/255, 214/255, 244/255)
DIM    = (108/255, 112/255, 134/255)
BG     = (24/255, 24/255, 37/255)
DIV    = (49/255, 50/255, 68/255)
SUB    = (37/255, 37/255, 53/255)

def rounded_rect(ctx, x, y, w, h, r):
    if r > min(w, h) / 2: r = min(w, h) / 2
    ctx.new_path()
    ctx.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    ctx.arc(x + w - r, y + r, r, 3 * math.pi / 2, 0)
    ctx.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    ctx.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    ctx.close_path()

# Title
cr.select_font_face("JetBrains Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
cr.set_font_size(20)
_, _, tw, _, _, _ = cr.text_extents("Keybindings")
cr.set_source_rgb(*GREEN)
cr.move_to((W - tw) / 2, 30)
cr.show_text("Keybindings")

# Split sections into 2 columns
mid = (len(sections) + 1) // 2
col_w = (W - 44) / 2
gap = 16

def draw_section(ctx, x, y, name, items, max_w):
    hdr_h = 26
    row_h = 22
    n = len(items)
    total_h = hdr_h + n * row_h + 6
    if y + total_h > H - 18:
        return y

    # Background
    ctx.set_source_rgb(*BG)
    rounded_rect(ctx, x, y, max_w, total_h, 6)
    ctx.fill()

    # Header
    ctx.select_font_face("JetBrains Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    ctx.set_font_size(11)
    ctx.set_source_rgb(*BLUE)
    ctx.move_to(x + 10, y + 17)
    ctx.show_text(name.upper())

    # Header divider
    ctx.set_source_rgb(*DIV)
    ctx.set_line_width(1)
    ctx.move_to(x + 10, y + hdr_h)
    ctx.line_to(x + max_w - 10, y + hdr_h)
    ctx.stroke()

    # Items
    ctx.select_font_face("JetBrains Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    ctx.set_font_size(10)
    for idx, (key, desc) in enumerate(items):
        ry = y + hdr_h + 4 + idx * row_h
        if ry + row_h > H - 18:
            break

        # Row bg (alternating)
        if idx % 2 == 0:
            ctx.set_source_rgb(*SUB)
            rounded_rect(ctx, x + 4, ry, max_w - 8, row_h - 2, 3)
            ctx.fill()

        # Key (bold, orange)
        ctx.select_font_face("JetBrains Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        ctx.set_source_rgb(*ORANGE)
        ctx.move_to(x + 12, ry + 14)
        ctx.show_text(key)
        _, _, kw, _, _, _ = ctx.text_extents(key)

        # Description
        ctx.select_font_face("JetBrains Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        ctx.set_source_rgb(*TEXT)
        dx = x + 18 + kw
        avail = max_w - (dx - x) - 12
        display = desc[0].upper() + desc[1:]
        display = display.replace("\u2192", "->").replace("`", "")
        _, _, dw, _, _, _ = ctx.text_extents(display)
        if dw > avail:
            while dw > avail - 12 and len(display) > 2:
                display = display[:-1]
                _, _, dw, _, _, _ = ctx.text_extents(display + "...")
            display += "..."
        ctx.move_to(dx, ry + 14)
        ctx.show_text(display)

    return y + total_h + 6

# Draw columns
x1, y1 = 22, 52
x2 = x1 + col_w + gap

for col, cx in [(sections[:mid], x1), (sections[mid:], x2)]:
    cy = y1
    for name, items in col:
        cy = draw_section(cr, cx, cy, name, items, col_w)

# Footer
cr.select_font_face("JetBrains Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
cr.set_font_size(10)
cr.set_source_rgb(*DIM)
footer = "Esc to close  |  Edit in Obsidian"
_, _, fw, _, _, _ = cr.text_extents(footer)
cr.move_to((W - fw) / 2, H - 12)
cr.show_text(footer)

surface.write_to_png(sys.argv[2])
surface.finish()
PYEOF

mpv --image-display-duration=inf \
    --no-audio \
    --title=hypr-cheatsheet \
    --geometry=960x720 \
    --input-conf=<(echo "ESC quit") \
    "$png_file" 2>/dev/null &disown