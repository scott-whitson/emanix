#!/usr/bin/env bash
# theme-switch — toggle hyprland/ghostty/waybar between dark and light themes
# Usage: theme-switch [dark|light]
#   No argument toggles between dark and light.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/theme-current"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"

current_theme() {
    cat "$STATE_FILE" 2>/dev/null || echo "dark"
}

target="${1:-}"

if [ -z "$target" ]; then
    if [ "$(current_theme)" = "dark" ]; then
        target="light"
    else
        target="dark"
    fi
fi

if [ "$target" != "dark" ] && [ "$target" != "light" ]; then
    echo "Usage: theme-switch [dark|light]" >&2
    exit 1
fi

# --- Swap symlinks (relative so they resolve within each config dir) ---
ln -sf "$target.conf" "$CONFIG/hypr/colors/theme.conf"
ln -sf "$target.conf" "$CONFIG/ghostty/theme.conf"
ln -sf "$target.css"  "$CONFIG/waybar/style.css"

# --- System color-scheme (Firefox, Electron/Obsidian, libadwaita read this) ---
if [ "$target" = "dark" ]; then
    gtk_theme="Adwaita-dark"
    color_scheme="prefer-dark"
else
    gtk_theme="Adwaita"
    color_scheme="prefer-light"
fi
gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || true
gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true

# --- Trigger live reloads ---
# Hyprland: reread config (picks up new $col_active/$col_inactive)
command -v hyprctl &>/dev/null && hyprctl reload &>/dev/null || true

# Waybar: SIGUSR2 triggers config + CSS reload
pkill -SIGUSR2 waybar 2>/dev/null || true

# Ghostty: SIGUSR2 reloads config (ghostty 1.2+)
pkill -SIGUSR2 ghostty 2>/dev/null || true

# --- Persist state ---
mkdir -p "$STATE_DIR"
echo "$target" > "$STATE_FILE"

echo "Switched to $target theme"
