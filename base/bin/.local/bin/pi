#!/usr/bin/env bash
set -euo pipefail

# Prefer the locally installed package, but fall back to npx if the
# install is missing or broken on this machine.
PI_CLI="$HOME/.local/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
if [[ -r "$PI_CLI" ]] && timeout 5s node "$PI_CLI" --version >/dev/null 2>&1; then
	exec node "$PI_CLI" "$@"
fi

exec npx --yes @earendil-works/pi-coding-agent "$@"
