#!/usr/bin/env bash
# Honcho health + activity summary.
#
# Shows:
# - service health
# - queue state
# - why queue is or is not moving
# - 24h / 7d message activity
# - token usage seen in logs

set -euo pipefail

HONCHO_URL="${HONCHO_URL:-http://datacore.scottwhitson.ts.net:8008}"
HONCHO_WORKSPACE="${HONCHO_WORKSPACE:-pi}"
HONCHO_STATS_HOST="${HONCHO_STATS_HOST:-datacore}"

find_auth_token() {
  if [[ -n "${HONCHO_API_KEY:-}" ]]; then
    printf '%s' "$HONCHO_API_KEY"
    return 0
  fi

  local auth_file="${HONCHO_AUTH_FILE:-$HOME/.pi/agent/auth.json}"
  [[ -f "$auth_file" ]] || return 0

  python3 - "$auth_file" <<'PY'
import json, re, sys
from collections.abc import Mapping, Sequence

path = sys.argv[1]
try:
    data = json.load(open(path))
except Exception:
    raise SystemExit(0)

key_re = re.compile(r'(?:^|[._-])(honcho|honchoapi|honcho_api|api[_-]?key|token)(?:$|[._-])', re.I)
priority = [
    'honcho',
    'honcho_api_key',
    'honcho-key',
    'honcho_key',
    'honcho-token',
    'honcho_token',
]

seen = []

def walk(obj, path=''):
    if isinstance(obj, Mapping):
        for k, v in obj.items():
            kp = f"{path}.{k}" if path else str(k)
            if isinstance(v, str) and v:
                seen.append((kp, v))
            walk(v, kp)
    elif isinstance(obj, Sequence) and not isinstance(obj, (str, bytes, bytearray)):
        for i, v in enumerate(obj):
            walk(v, f"{path}[{i}]")

walk(data)

for wanted in priority:
    for kp, v in seen:
        if kp.lower().endswith(wanted.replace('_', '').replace('-', '')):
            print(v)
            raise SystemExit(0)

for kp, v in seen:
    leaf = kp.rsplit('.', 1)[-1].lower().replace('-', '').replace('_', '')
    if 'honcho' in leaf or key_re.search(kp):
        print(v)
        raise SystemExit(0)
PY
}

curl_json() {
  local out_file="$1"
  shift
  if [[ -n "${auth_token:-}" ]]; then
    curl -fsS -H "Authorization: Bearer ${auth_token}" "$@" -o "$out_file"
  else
    curl -fsS "$@" -o "$out_file"
  fi
}

health_file="$(mktemp)"
queue_file="$(mktemp)"
remote_file="$(mktemp)"
trap 'rm -f "$health_file" "$queue_file" "$remote_file"' EXIT

auth_token="$(find_auth_token || true)"

curl_json "$health_file" "$HONCHO_URL/health"
if ! curl_json "$queue_file" "$HONCHO_URL/v3/workspaces/$HONCHO_WORKSPACE/queue/status"; then
  printf '{}' >"$queue_file"
fi

if ssh -o BatchMode=yes -o ConnectTimeout=5 "$HONCHO_STATS_HOST" true >/dev/null 2>&1; then
  ssh "$HONCHO_STATS_HOST" 'bash -s' <<'REMOTE' >"$remote_file"
set -euo pipefail
cd ~/projects/datacore-config/stacks/honcho
python3 <<'PY'
import json
import re
import subprocess
from pathlib import Path

ROOT = Path('/home/scott/projects/datacore-config/stacks/honcho')
WORKSPACE = 'pi'


def run(cmd, *, check=True):
    proc = subprocess.run(
        cmd,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
    )
    return proc.stdout


def psql(sql: str) -> list[str]:
    out = run([
        'docker', 'compose', 'exec', '-T', 'database',
        'psql', '-U', 'postgres', '-d', 'postgres', '-AtF', '\t',
        '-c', sql,
    ])
    return [line for line in out.splitlines() if line.strip()]


def json_cmd(cmd: list[str]) -> dict:
    return json.loads(run(cmd))


def perf_stats(since: str) -> dict[str, int]:
    logs = run(['docker', 'compose', 'logs', '--no-color', '--since', since, 'api', 'deriver'], check=False)
    blocks = re.findall(r'╭─────────── ⚡ PERFORMANCE.*?╰───────────', logs, flags=re.S)
    calls = 0
    input_tokens = 0
    output_tokens = 0
    for block in blocks:
        in_m = re.search(r'Input Tokens\s+(\d+)', block)
        out_m = re.search(r'Output Tokens\s+(\d+)', block)
        if in_m or out_m:
            calls += 1
            if in_m:
                input_tokens += int(in_m.group(1))
            if out_m:
                output_tokens += int(out_m.group(1))
    return {
        'calls': calls,
        'input_tokens': input_tokens,
        'output_tokens': output_tokens,
        'total_tokens': input_tokens + output_tokens,
    }


settings = json_cmd([
    'docker', 'compose', 'exec', '-T', 'api', '/app/.venv/bin/python', '-c',
    'from src.config import settings; import json; print(json.dumps({'
    '"flush_enabled": settings.DERIVER.FLUSH_ENABLED, '
    '"batch_max_tokens": settings.DERIVER.REPRESENTATION_BATCH_MAX_TOKENS, '
    '"workers": settings.DERIVER.WORKERS'
    '}))'
])

queue = {}
queue_rows = psql(f"""
SELECT
  count(*) AS pending_rows,
  count(DISTINCT work_unit_key) AS pending_work_units,
  count(*) FILTER (WHERE task_type = 'representation') AS representation_rows,
  count(DISTINCT work_unit_key) FILTER (WHERE task_type = 'representation') AS representation_work_units,
  coalesce(sum(m.token_count) FILTER (WHERE task_type = 'representation'), 0) AS representation_tokens,
  coalesce(min(q.created_at) FILTER (WHERE q.task_type = 'representation'), now()) AS oldest_representation_created_at,
  coalesce(extract(epoch from now() - min(q.created_at) FILTER (WHERE q.task_type = 'representation')), 0) AS oldest_representation_age_seconds,
  count(*) FILTER (WHERE task_type = 'representation' AND coalesce(m.token_count, 0) >= {settings['batch_max_tokens']}) AS eligible_representation_rows,
  count(DISTINCT work_unit_key) FILTER (WHERE task_type = 'representation' AND coalesce(m.token_count, 0) >= {settings['batch_max_tokens']}) AS eligible_representation_work_units,
  count(*) FILTER (WHERE task_type = 'representation' AND coalesce(m.token_count, 0) < {settings['batch_max_tokens']}) AS blocked_representation_rows,
  count(DISTINCT work_unit_key) FILTER (WHERE task_type = 'representation' AND coalesce(m.token_count, 0) < {settings['batch_max_tokens']}) AS blocked_representation_work_units,
  count(*) FILTER (WHERE q.processed AND q.created_at >= now() - interval '24 hours' AND q.task_type IN ('representation', 'summary', 'dream')) AS processed_24h,
  count(*) FILTER (WHERE q.processed AND q.created_at >= now() - interval '7 days' AND q.task_type IN ('representation', 'summary', 'dream')) AS processed_7d,
  count(*) FILTER (WHERE q.created_at >= now() - interval '24 hours' AND q.task_type IN ('representation', 'summary', 'dream')) AS enqueued_24h,
  count(*) FILTER (WHERE q.created_at >= now() - interval '7 days' AND q.task_type IN ('representation', 'summary', 'dream')) AS enqueued_7d
FROM queue q
LEFT JOIN messages m ON q.message_id = m.id
WHERE q.workspace_name = '{WORKSPACE}';
""")

active_sessions = psql("SELECT count(*) FROM active_queue_sessions;")
queue.update({
    'pending_rows': int(queue_rows[0].split('\t')[0]),
    'pending_work_units': int(queue_rows[0].split('\t')[1]),
    'representation_rows': int(queue_rows[0].split('\t')[2]),
    'representation_work_units': int(queue_rows[0].split('\t')[3]),
    'representation_tokens': int(queue_rows[0].split('\t')[4]),
    'oldest_representation_created_at': queue_rows[0].split('\t')[5],
    'oldest_representation_age_seconds': int(float(queue_rows[0].split('\t')[6])),
    'eligible_representation_rows': int(queue_rows[0].split('\t')[7]),
    'eligible_representation_work_units': int(queue_rows[0].split('\t')[8]),
    'blocked_representation_rows': int(queue_rows[0].split('\t')[9]),
    'blocked_representation_work_units': int(queue_rows[0].split('\t')[10]),
    'processed_24h': int(queue_rows[0].split('\t')[11]),
    'processed_7d': int(queue_rows[0].split('\t')[12]),
    'enqueued_24h': int(queue_rows[0].split('\t')[13]),
    'enqueued_7d': int(queue_rows[0].split('\t')[14]),
    'active_queue_sessions': int(active_sessions[0].split('\t')[0]),
})

messages = psql(f"""
SELECT
  count(*) FILTER (WHERE created_at >= now() - interval '24 hours') AS messages_24h,
  count(*) FILTER (WHERE created_at >= now() - interval '7 days') AS messages_7d,
  coalesce(sum(token_count) FILTER (WHERE created_at >= now() - interval '24 hours'), 0) AS message_tokens_24h,
  coalesce(sum(token_count) FILTER (WHERE created_at >= now() - interval '7 days'), 0) AS message_tokens_7d
FROM messages
WHERE workspace_name = '{WORKSPACE}';
""")
messages_stats = [int(x) for x in messages[0].split('\t')]

print(json.dumps({
    'settings': settings,
    'queue': queue,
    'messages': {
        'messages_24h': messages_stats[0],
        'messages_7d': messages_stats[1],
        'message_tokens_24h': messages_stats[2],
        'message_tokens_7d': messages_stats[3],
    },
    'perf_24h': perf_stats('24h'),
    'perf_7d': perf_stats('7d'),
}))
PY
REMOTE
else
  printf '{}' >"$remote_file"
fi

python3 - "$health_file" "$queue_file" "$remote_file" "$HONCHO_URL" "$HONCHO_WORKSPACE" <<'PY'
import json
import sys
from pathlib import Path

health = json.loads(Path(sys.argv[1]).read_text())
queue_status = json.loads(Path(sys.argv[2]).read_text())
remote = json.loads(Path(sys.argv[3]).read_text() or '{}')
url = sys.argv[4]
workspace = sys.argv[5]

print(f"Honcho health: {health.get('status', 'unknown').upper()}")
print(f"URL: {url}")
print(f"Workspace: {workspace}")
print()

if queue_status:
    print('Queue endpoint:')
    print(f"  total work units: {queue_status.get('total_work_units', 'n/a')}")
    print(f"  completed: {queue_status.get('completed_work_units', 'n/a')}")
    print(f"  in progress: {queue_status.get('in_progress_work_units', 'n/a')}")
    print(f"  pending: {queue_status.get('pending_work_units', 'n/a')}")
    print()

if remote:
    s = remote.get('settings', {})
    q = remote.get('queue', {})
    m = remote.get('messages', {})
    p24 = remote.get('perf_24h', {})
    p7 = remote.get('perf_7d', {})

    print('Worker state:')
    print(f"  workers: {s.get('workers', 'n/a')}")
    print(f"  flush enabled: {s.get('flush_enabled', 'n/a')}")
    print(f"  representation batch threshold: {s.get('batch_max_tokens', 'n/a')} tokens")
    print(f"  active queue sessions: {q.get('active_queue_sessions', 'n/a')}")
    print()

    print('Queue diagnosis:')
    print(f"  pending rows: {q.get('pending_rows', 'n/a')}")
    print(f"  pending work units: {q.get('pending_work_units', 'n/a')}")
    print(f"  representation rows: {q.get('representation_rows', 'n/a')}")
    print(f"  representation work units: {q.get('representation_work_units', 'n/a')}")
    print(f"  representation tokens: {q.get('representation_tokens', 'n/a')}")
    print(f"  oldest pending age: {round(q.get('oldest_representation_age_seconds', 0) / 3600, 2)} h")
    print(f"  eligible representation work units: {q.get('eligible_representation_work_units', 'n/a')}")
    print(f"  blocked representation work units: {q.get('blocked_representation_work_units', 'n/a')}")

    if q.get('pending_work_units', 0) and q.get('active_queue_sessions', 0) == 0:
        if not s.get('flush_enabled') and q.get('eligible_representation_work_units', 0) == 0:
            print('  state: DEFERRED — below batch threshold, so worker should not claim yet')
        elif q.get('eligible_representation_work_units', 0) > 0:
            print('  state: STALLED — eligible work exists, but no active worker owns it')
        else:
            print('  state: PENDING — no clear blocker')
    elif q.get('active_queue_sessions', 0) > 0:
        print('  state: ACTIVE')
    else:
        print('  state: EMPTY')
    print()

    print('24h / 7d activity:')
    print(f"  messages added: {m.get('messages_24h', 'n/a')} / {m.get('messages_7d', 'n/a')}")
    print(f"  message token sum: {m.get('message_tokens_24h', 'n/a')} / {m.get('message_tokens_7d', 'n/a')}")
    print(f"  queue enqueued: {q.get('enqueued_24h', 'n/a')} / {q.get('enqueued_7d', 'n/a')}")
    print(f"  queue processed: {q.get('processed_24h', 'n/a')} / {q.get('processed_7d', 'n/a')}")
    print(f"  llm call blocks in logs: {p24.get('calls', 'n/a')} / {p7.get('calls', 'n/a')}")
    print(f"  llm call tokens in: {p24.get('input_tokens', 'n/a')} / {p7.get('input_tokens', 'n/a')}")
    print(f"  llm call tokens out: {p24.get('output_tokens', 'n/a')} / {p7.get('output_tokens', 'n/a')}")
else:
    print('Remote stats: unavailable')
    print('  remote DB/log access failed or host unreachable')

print()
print('Note: message token sum = ingest proxy. LLM call tokens = model calls seen in logs, not queue items.')
PY
