#!/usr/bin/env bash
# hypr-brightness — adjust screen brightness from Hyprland bindings.
# Usage: hypr-brightness up|down [step]
set -euo pipefail

action="${1:-}"
step="${2:-5}"

case "$action" in
  up|down) ;;
  *)
    echo "Usage: hypr-brightness up|down [step]" >&2
    exit 2
    ;;
esac

if command -v brightnessctl >/dev/null 2>&1; then
  if [[ "$action" == "up" ]]; then
    exec brightnessctl set "${step}%+"
  else
    exec brightnessctl set "${step}%-"
  fi
fi

if command -v light >/dev/null 2>&1; then
  if [[ "$action" == "up" ]]; then
    exec light -A "$step"
  else
    exec light -U "$step"
  fi
fi

echo "hypr-brightness: neither brightnessctl nor light is installed" >&2
exit 1
