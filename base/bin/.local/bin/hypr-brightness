#!/usr/bin/env bash
# hypr-brightness — adjust screen brightness from Hyprland bindings.
# Usage: hypr-brightness up|down [step]
set -euo pipefail

action="${1:-}"
step="${2:-5}"

case "$action" in
  up|down) ;;
  *)
    echo "Usage: hypr-brightness up|down [step]" >&2
    exit 2
    ;;
esac

log() {
  printf 'hypr-brightness: %s\n' "$*" >&2
}

pick_backlight() {
  if [[ -d /sys/class/backlight/intel_backlight ]]; then
    printf '%s' intel_backlight
    return 0
  fi

  for d in /sys/class/backlight/*; do
    [[ -d "$d" ]] || continue
    basename "$d"
    return 0
  done

  return 1
}

brightnessctl_set() {
  local device="$1"
  if ! command -v brightnessctl >/dev/null 2>&1; then
    return 1
  fi

  if [[ "$action" == "up" ]]; then
    brightnessctl -d "$device" set "${step}%+"
  else
    brightnessctl -d "$device" set "${step}%-"
  fi
}

sysfs_set() {
  local device="$1" brightness_file max_file current max delta new
  brightness_file="/sys/class/backlight/$device/brightness"
  max_file="/sys/class/backlight/$device/max_brightness"

  [[ -r "$brightness_file" && -r "$max_file" ]] || return 1
  [[ -w "$brightness_file" ]] || return 1

  current="$(<"$brightness_file")"
  max="$(<"$max_file")"
  delta=$((max * step / 100))
  [[ "$delta" -gt 0 ]] || delta=1

  if [[ "$action" == "up" ]]; then
    new=$((current + delta))
    (( new > max )) && new="$max"
  else
    new=$((current - delta))
    (( new < 0 )) && new=0
  fi

  printf '%s\n' "$new" > "$brightness_file"
}

light_set() {
  local device="$1"
  if ! command -v light >/dev/null 2>&1; then
    return 1
  fi

  if [[ "$action" == "up" ]]; then
    light -s "$device" -A "$step"
  else
    light -s "$device" -U "$step"
  fi
}

device="$(pick_backlight)" || device=""
if [[ -z "$device" ]]; then
  log "no backlight device found under /sys/class/backlight"
  exit 1
fi

if brightnessctl_set "$device"; then
  exit 0
fi

if sysfs_set "$device"; then
  exit 0
fi

if light_set "$device"; then
  exit 0
fi

log "could not adjust brightness for '$device' (brightnessctl/light missing or no write permission)"
exit 1
