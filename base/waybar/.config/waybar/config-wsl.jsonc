{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 2,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["custom/clock"],
    "modules-right": ["cpu", "memory"],

    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": false
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "custom/clock": {
        "exec": "~/.config/waybar/clock-wsl.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "interval": 30
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "mem {percentage}%",
        "interval": 5
    }
}
