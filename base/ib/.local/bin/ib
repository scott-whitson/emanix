#!/usr/bin/env bash
# ib — wrapper for IB Gateway running headless under Xvfb via IBC.
#
# Usage:
#   ib up   [live|paper]   start IB Gateway service (default: live)
#   ib down [live|paper]   stop IB Gateway service
#   ib status              show service + listening ports
#   ib logs [live|paper]   tail journalctl
#   ib restart [live|paper]
#
# First cold-start of `ib up live` triggers a 2FA push to your phone — tap to approve.
# Once running, the service stays up across screen lock; reboots require manual restart
# unless `loginctl enable-linger scott` is set.

set -euo pipefail

cmd="${1:-}"
mode="${2:-live}"

case "$mode" in
    live|paper) ;;
    *) echo "ib: mode must be 'live' or 'paper' (got: $mode)" >&2; exit 2 ;;
esac

unit="ib-gateway@${mode}.service"

case "$cmd" in
    up)
        systemctl --user start "$unit"
        echo "started $unit — first start: tap 2FA on phone if push arrives"
        echo "watch logs:  ib logs $mode"
        ;;
    down)
        systemctl --user stop "$unit"
        ;;
    restart)
        systemctl --user restart "$unit"
        ;;
    status)
        systemctl --user status "ib-gateway@live.service" --no-pager 2>/dev/null | head -5 || true
        systemctl --user status "ib-gateway@paper.service" --no-pager 2>/dev/null | head -5 || true
        echo
        echo "listening ports:"
        ss -tln 2>/dev/null | grep -E ':(4001|4002) ' || echo "  (no IB ports listening)"
        # Guardrail for the rogue ~/.YYYYMMDD.local/ pattern. If it ever appears
        # under our managed setup, the systemd journal will show what ran around
        # that timestamp — `ib logs <mode>` to investigate.
        rogue=( "$HOME"/.[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].local )
        if [[ -e "${rogue[0]}" ]]; then
            echo
            echo "WARNING: rogue dated dirs at home root:"
            printf '  %s\n' "${rogue[@]}"
            echo "  → cleanup:  rm -rf ~/.[0-9]*.local"
        fi
        ;;
    logs)
        journalctl --user -u "$unit" -f
        ;;
    *)
        echo "Usage: ib {up|down|restart|status|logs} [live|paper]"
        exit 1
        ;;
esac
