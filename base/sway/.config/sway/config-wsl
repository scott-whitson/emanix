# -----------------------------------------------
# Sway Configuration (WSL / WSLg)
# -----------------------------------------------
# Runs as a nested Wayland compositor inside WSLg.
# Launch with: start-sway.sh

# --- Disable Xwayland (not needed in WSL, avoids sticky bit errors) ---
xwayland disable

# --- Mod key (Alt to avoid Windows key conflicts) ---
set $mod Mod1

# --- Terminal & launcher ---
set $term LIBGL_ALWAYS_SOFTWARE=1 kitty
set $menu wofi --show drun

# --- Autostart ---
exec waybar -c ~/.config/waybar/config-wsl.jsonc

# --- Shared config (appearance, keybindings, workspaces) ---
include ~/.config/sway/config-common
