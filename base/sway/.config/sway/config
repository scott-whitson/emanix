# -----------------------------------------------
# Sway Configuration (Native Linux)
# -----------------------------------------------

# --- Mod key ---
set $mod Mod4

# --- Terminal & launcher ---
set $term kitty
set $menu wofi --show drun

# --- Pass environment to systemd/dbus (needed for portals, waybar, etc.) ---
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK

# --- Autostart ---
exec waybar
exec mako
exec_always autotiling-rs
exec swayidle -w \
    timeout 600 'swaylock -f -c 1a1b26' \
    timeout 660 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 1a1b26'

# --- Input ---
input type:keyboard {
    xkb_layout us
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# --- Monitor positions (external above laptop) ---
output HDMI-A-1 position 0 0
output eDP-1 position 0 1080

# --- Shared config (appearance, keybindings, workspaces) ---
include ~/.config/sway/config-common

# --- Native-only: app launchers ---
bindsym $mod+w exec firefox
bindsym $mod+e exec thunar

# --- Screenshots ---
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym Ctrl+Print exec grim - | wl-copy

# --- Media keys ---
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Lock screen ---
bindsym $mod+Escape exec swaylock -f -c 1a1b26

# --- Hide cursor after 5 seconds of inactivity ---
seat * hide_cursor 5000
