{
  "lastChangelogVersion": "0.78.0",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.4-mini",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-caveman",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:gentle-pi",
      "extensions": [
        "gentle-ai.ts",
        "sdd-init.ts",
        "skill-registry.ts"
      ]
    },
    "npm:pi-intercom",
    "npm:pi-lens"
  ],
  "enabledModels": [
    "openai/gpt-5.4-mini",
    "openai/gpt-5.4",
    "openai/gpt-5.4-nano"
  ],
  "theme": "catppuccin-mocha",
  "honcho": {
    "enabled": true,
    "url": "http://datacore.scottwhitson.ts.net:8008",
    "workspace": "pi",
    "policy": "query before answer when personalized memory likely helps; write only curated durable facts, decisions, and preferences"
  }
}