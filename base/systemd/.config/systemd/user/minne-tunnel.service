[Unit]
Description=SSH tunnel from laptop:4002 to minne-server:4002 (IB Gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -N: no remote command. -o flags: make the tunnel robust across sleeps and
# short network drops without us having to babysit it.
ExecStart=/usr/bin/ssh -N \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -o TCPKeepAlive=yes \
    -L 4002:localhost:4002 minne
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
