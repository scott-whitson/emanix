{
    "disk": {
        "main": {
            "content": {
                "partitions": {
                    "boot": {
                        "content": {
                            "format": "vfat",
                            "mountOptions": [
                                "fmask=0077",
                                "dmask=0077"
                            ],
                            "mountpoint": "/boot",
                            "type": "filesystem"
                        },
                        "size": "1G",
                        "type": "EF00"
                    },
                    "root": {
                        "content": {
                            "content": {
                                "extraArgs": [
                                    "-f"
                                ],
                                "subvolumes": {
                                    "@": {
                                        "mountOptions": [
                                            "compress=zstd"
                                        ],
                                        "mountpoint": "/"
                                    },
                                    "@home": {
                                        "mountOptions": [
                                            "compress=zstd"
                                        ],
                                        "mountpoint": "/home"
                                    },
                                    "@nix": {
                                        "mountOptions": [
                                            "compress=zstd",
                                            "noatime"
                                        ],
                                        "mountpoint": "/nix"
                                    }
                                },
                                "type": "btrfs"
                            },
                            "name": "cryptroot",
                            "settings": {
                                "allowDiscards": true
                            },
                            "type": "luks"
                        },
                        "size": "100%"
                    }
                },
                "type": "gpt"
            },
            "device": "/dev/nvme0n1",
            "type": "disk"
        }
    }
}
