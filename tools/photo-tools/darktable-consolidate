#!/usr/bin/env python3
"""
darktable-consolidate: One-off cleanup for the ~/Darktable vs ~/gdrive/Photos/Darktable
situation after darktable's first-launch import on linux duplicated everything.

Hash-matches every JPG in ~/Darktable against ~/gdrive/Photos/Darktable. Files that
already exist in gdrive are reported as matched. Files unique to ~/Darktable are
reported as orphans and, with --copy-orphans, moved into a dated subfolder under
gdrive so nothing is lost before ~/Darktable is deleted.

Usage:
    darktable-consolidate                    Dry-run report
    darktable-consolidate --copy-orphans     Copy orphans into gdrive

This is a one-shot tool — not meant to be re-run.
"""

import argparse
import hashlib
import shutil
import sys
from pathlib import Path

SRC = Path.home() / "Darktable"
DST = Path.home() / "gdrive/Photos/Darktable"
ORPHAN_SUBDIR = "20260330_01FEB26_extras"

HASH_BUF = 1 << 16


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(HASH_BUF):
            h.update(chunk)
    return h.hexdigest()


def index_jpgs(root, label):
    jpgs = sorted(p for p in root.rglob("*.JPG") if p.is_file())
    print(f"Hashing {len(jpgs)} JPGs in {label}…", file=sys.stderr)
    index = {}
    for i, p in enumerate(jpgs, 1):
        if i % 100 == 0:
            print(f"  {i}/{len(jpgs)}", file=sys.stderr)
        index.setdefault(sha256_file(p), []).append(p)
    return index


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--copy-orphans", action="store_true",
                    help=f"Copy orphan JPGs into {DST}/{ORPHAN_SUBDIR}/")
    args = ap.parse_args()

    if not SRC.is_dir():
        sys.exit(f"error: {SRC} does not exist")
    if not DST.is_dir():
        sys.exit(f"error: {DST} does not exist")

    dst_index = index_jpgs(DST, "gdrive")
    src_index = index_jpgs(SRC, "~/Darktable")

    matched = []
    orphans = []
    for sha, paths in src_index.items():
        if sha in dst_index:
            matched.extend(paths)
        else:
            orphans.extend(paths)

    print()
    print(f"Matched (already in gdrive): {len(matched)}")
    print(f"Orphans (unique to ~/Darktable): {len(orphans)}")
    print()

    if orphans:
        print("Orphan files:")
        for p in sorted(orphans):
            print(f"  {p.relative_to(SRC)}")
        print()

    if not orphans:
        print("No orphans — safe to delete ~/Darktable after resetting darktable's library.")
        return

    if not args.copy_orphans:
        print("Dry-run. Re-run with --copy-orphans to copy these into gdrive.")
        return

    dest_dir = DST / ORPHAN_SUBDIR
    dest_dir.mkdir(exist_ok=True)
    print(f"Copying {len(orphans)} orphans to {dest_dir}/ …")
    for p in sorted(orphans):
        target = dest_dir / p.name
        if target.exists():
            print(f"  SKIP (exists): {p.name}")
            continue
        shutil.copy2(p, target)
        print(f"  copied: {p.name}")
    print()
    print(f"Done. Orphans are in {dest_dir}.")
    print("You can now reset darktable's library and delete ~/Darktable.")


if __name__ == "__main__":
    main()
