# One definition of the environment every emanix surface exports.
#
# There were three hand-copied lists — the zsh session, the systemd user
# manager, and the EWM login session — and they had already drifted: the user
# manager was missing EMANIX_ROLE, and the EWM login session was missing
# EMANIX, EMANIX_ROLE and the two optional entries. The failure is silent in
# both directions, because every reader is an elisp `getenv' that returns nil
# for a variable nobody exported, and the branch that wanted it quietly takes
# its default.
#
# Callers pass their own config: home/*.nix has `config', and modules/ewm.nix
# has the Home Manager instance it was handed as `hmCfg'.
{ lib }:
{
  mkEmanixEnv =
    { src, role, theme }:
    {
      # The emanix checkout. A consumer that checks out elsewhere gets its own
      # path here. Nothing in the distribution reads it; elisp and a consumer's
      # shell do.
      EMANIX = src.path;
      # The theme tree generated by lib/theme-tree.nix, which the active-theme
      # tooling reads.
      EMANIX_THEMES_DIR = src.themesDir;
      # The host's BUILD-TIME theme, as distinct from the tree above and from
      # the runtime choice emanix-theme.el records. `emanix-theme--seed-name'
      # reads it to converge a machine with no runtime state on the theme its
      # flake configures, and consults it once — so it never overrides a theme
      # the user has switched to.
      EMANIX_THEME = theme;
      # The emanix.role label. Nothing in the distribution dispatches on it; a
      # consumer can, and a branch that runs under the user manager or the EWM
      # Emacs reads it from here like any other surface.
      EMANIX_ROLE = role;
    }
    # Helper scripts: a consumer that keeps them sets src.binDir and gets it
    # first on PATH. UNSET on a host built from the distribution alone, which
    # ships no bin/.
    // lib.optionalAttrs (src.binDir != null) {
      EMANIX_BIN_DIR = src.binDir;
    }
    # The CONSUMER's checkout, which emanix-welcome.el offers as the config
    # repository. UNSET on a base host; without it the welcome buffer falls
    # through to ~/flake and /etc/nixos.
    // lib.optionalAttrs (src.dotfilesPath != null) {
      EMANIX_DOTFILES = src.dotfilesPath;
    };
}
