#!/usr/bin/env bash
# fresh-emanix-install — one-shot NixOS installer for an emanix host.
#
# Usage (in the emanix installer ISO, or any NixOS live ISO):
#   sudo fresh-emanix-install [host] [--disk /dev/X] [--check-only]
#
# The host is required. The repo is located automatically (EMANIX_REPO, the
# script's parent, /etc/emanix/flake on the ISO, or common mounts); the
# host key comes from the baked ISO keys, a staged <host>-keys/ dir beside the
# repo, or a prompt; the target disk is auto-detected (largest non-removable
# device with no mounted partitions) unless --disk is given. --check-only
# prints the preflight checklist and exits without touching anything.
#
# Automates: preflight -> disko -> inject host key -> nixos-install
# -> set password -> reboot. Full context: docs/ioshi/emanix-install.md.
# Spec: docs/superpowers/specs/2026-08-15-emanix-installer-iso-design.md
set -euo pipefail

say()  { printf '\n\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARNING:\033[0m %s\n' "$*"; }
die()  { printf '\n\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# Leave the disk retryable. disko mounts /mnt and opens LUKS as `cryptroot`
# before nixos-install runs; if that build fails, an untrapped exit leaves both
# in place -- and the NEXT run cannot recover, because resolve_disk skips any
# device with mounted partitions, so the target becomes invisible and the run
# dies at "preflight failed: disk". The first failure makes the second attempt
# impossible, which is the worst property an installer can have.
#
# Suppressed on success: some flows reboot from a mounted /mnt, and a trap that
# fires on the happy path is its own bug.
INSTALL_OK=0
cleanup_target() {
  [ "$INSTALL_OK" -eq 1 ] && return 0
  # Nothing mounted means nothing to do -- a preflight abort must stay silent.
  mountpoint -q /mnt 2>/dev/null || return 0
  warn "install did not complete — unmounting /mnt so a retry can see the disk."
  umount -R /mnt 2>/dev/null || true
  cryptsetup close cryptroot 2>/dev/null || true
}
trap cleanup_target EXIT

# --- Args: [host] [--disk /dev/X | positional] [--check-only] ----------------
FLAKE_HOST=""
DISK=""
CHECK_ONLY=0
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  a="${args[$i]}"
  case "$a" in
    --check-only) CHECK_ONLY=1 ;;
    --disk)
      i=$((i + 1))
      DISK="${args[$i]:-}"
      [ -n "$DISK" ] || die "--disk needs a value."
      ;;
    --disk=*) DISK="${a#--disk=}" ;;
    -*) die "unknown option: $a" ;;
    *)
      if [ -z "$FLAKE_HOST" ]; then FLAKE_HOST="$a"; else DISK="${DISK:-$a}"; fi
      ;;
  esac
  i=$((i + 1))
done
# A missing host is no longer an error: it means "install a machine this flake
# has never heard of", which is the only mode a stranger can use. The host
# argument is still how the existing fleet installs, and that path is
# untouched below.
MODE=prestaged
validate_hostname() {
  # RFC 1123: lowercase alphanumeric and hyphen, no leading/trailing hyphen,
  # 1-63 chars. Rejected here rather than by nixos-install, which fails much
  # later and less clearly.
  printf '%s' "$1" | grep -qE '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
}

# Same character class as a hostname, and the same reason: this value reaches a
# `bash -c` string in the chroot. Named separately from validate_hostname so
# the call sites read correctly.
validate_username() { validate_hostname "$1"; }

known_hosts() {
  # Ask the flake rather than keeping a list here; a list is a thing that
  # drifts. Failure to evaluate means an unusable repo, so it is fatal.
  nix eval --raw "$REPO#nixosConfigurations" \
    --apply 'cfgs: builtins.concatStringsSep " " (builtins.attrNames cfgs)' \
    2>/dev/null
}

# --- Locate the repo ----------------------------------------------------------
resolve_repo() {
  if [ -n "${EMANIX_REPO:-}" ] && [ -f "$EMANIX_REPO/flake.nix" ]; then
    REPO="$EMANIX_REPO"
    return
  fi
  SELF="$(realpath "${BASH_SOURCE[0]}")"
  if [ -f "$(dirname "$(dirname "$SELF")")/flake.nix" ]; then
    REPO="$(dirname "$(dirname "$SELF")")"
    return
  fi
  for cand in /etc/emanix/flake /mnt/flake /run/media/*/*/flake /media/*/flake; do
    # shellcheck disable=SC2086 # globs are the point of the bounded scan
    [ -f "$cand/flake.nix" ] && { REPO="$cand"; return; }
  done
  die "could not locate the emanix flake. Tried: \$EMANIX_REPO, the script's
parent, /etc/emanix/flake, /mnt/flake, /run/media/*/*/flake,
/media/*/flake. Set EMANIX_REPO to the repo path and re-run."
}

# --- Locate the host key (baked ISO -> staged dir -> prompt) ------------------
# Sets KEY_DIR, or leaves it empty (check-only reports; real mode dies later).
resolve_keys() {
  KEY_DIR=""
  if [ -f "/etc/emanix/keys/${FLAKE_HOST}_host_ed25519" ] &&
    [ -f "/etc/emanix/keys/${FLAKE_HOST}_host_ed25519.pub" ]; then
    KEY_DIR=/etc/emanix/keys
    return
  fi
  if [ -f "$(dirname "$REPO")/${FLAKE_HOST}-keys/${FLAKE_HOST}_host_ed25519" ]; then
    KEY_DIR="$(dirname "$REPO")/${FLAKE_HOST}-keys"
    return
  fi
  if [ "$CHECK_ONLY" -eq 0 ]; then
    read -rp "Directory holding ${FLAKE_HOST}_host_ed25519(.pub): " kd
    if [ -n "$kd" ] && [ -f "$kd/${FLAKE_HOST}_host_ed25519" ]; then KEY_DIR="$kd"; fi
  fi
}

# --- Target disk: largest non-removable, RW, with no mounted partitions -------
resolve_disk() {
  if [ -n "$DISK" ]; then return; fi
  best=""
  best_size=0
  for name in $(lsblk -bndo NAME); do
    [ "$(lsblk -bndo RO "/dev/$name")" = "0" ] || continue        # skip read-only
    [ "$(lsblk -bndo TRAN "/dev/$name")" = "usb" ] && continue    # skip the stick
    lsblk -no MOUNTPOINTS "/dev/$name" | grep -q . && continue    # skip mounted disks
    size="$(lsblk -bndo SIZE "/dev/$name")"
    if [ "${size:-0}" -gt "$best_size" ]; then best="$name"; best_size="$size"; fi
  done
  if [ -n "$best" ]; then DISK="/dev/$best"; fi
}

# --- Interactive mode: generate a host, then install it -----------------------
# The installer MUST write a flake before it can install: nixos-install --flake
# needs the host to exist in one. So this writes the minimum to boot, from
# templates/default, and emanix-init later adopts it into a real repo.
interactive_prompts() {
  # emanix.installer.flake can legitimately be a CONSUMING flake (the fleet's
  # own, staged for the pre-staged path) with no templates/ directory at
  # all -- interactive mode only ever needed one because write_generated_flake
  # later does a bare `cp -r "$REPO/templates/default/."`. Checked here,
  # before any prompt, so a repo with no template dies before the user
  # answers a single question -- not after they have already typed 'yes' to
  # wipe a disk and this same gap surfaces as a raw `cp` error with the disk
  # already destroyed.
  [ -d "$REPO/templates/default" ] ||
    die "this installer's flake ($REPO) carries no templates/default -- it
looks like a consuming flake staged for known hosts only, not one that can
generate a new one. Interactive mode (no host argument, or a hostname this
flake has never heard of) needs a flake with a templates/default, such as
emanix's own. Re-run with a known host name instead, or point EMANIX_REPO at
a flake that ships templates/default."

  if [ -z "$FLAKE_HOST" ]; then
    while :; do
      read -rp "Hostname for this machine: " FLAKE_HOST
      validate_hostname "$FLAKE_HOST" && break
      warn "lowercase letters, digits and hyphens only, 1-63 chars."
    done
  fi

  # RULING (task 3): write_generated_flake bakes a username into the generated
  # flake.nix, but USERNAME is otherwise only assigned after nixos-install, by
  # probing /mnt/home -- far too late for generation time. Same character
  # class as a hostname, so validate_hostname is reused rather than
  # duplicated. Getting this wrong means a flake whose `username` does not
  # match the account actually created, i.e. a machine its own owner cannot
  # log into.
  while :; do
    read -rp "Username for your account: " USERNAME
    validate_hostname "$USERNAME" && break
    warn "lowercase letters, digits and hyphens only, 1-63 chars."
  done

  say "Network"
  if ping -c1 -W4 cache.nixos.org >/dev/null 2>&1; then
    echo "  already online."
  else
    warn "no route to cache.nixos.org."
    echo "  WiFi: run 'nmtui' (or 'iwctl station wlan0 connect <ssid>') in another"
    echo "  console, then return here."
    read -rp "Press Enter once the network is up: " _
    ping -c1 -W4 cache.nixos.org >/dev/null 2>&1 ||
      die "still no route to cache.nixos.org — the install downloads packages."
  fi

  read -rp "Encrypt the disk with LUKS? [Y/n] " a
  case "$a" in [Nn]*) LUKS=false ;; *) LUKS=true ;; esac

  read -rp "Root filesystem [btrfs/ext4] (btrfs): " a
  case "$a" in ext4) FSTYPE=ext4 ;; *) FSTYPE=btrfs ;; esac

  # Fix (review round 1, finding 3): SWAPSIZE lands in a Nix string literal
  # inside a heredoc in write_generated_flake. Unvalidated, a stray quote in
  # the answer produces a syntactically broken host.nix on a code path that
  # has already committed to wiping a disk. Re-prompt rather than die: this
  # one is easy to just get right on a second try.
  while :; do
    read -rp "Swap partition size, e.g. 8G, or 0 for none (0): " a
    SWAPSIZE="${a:-0}"
    validate_swapsize "$SWAPSIZE" && break
    warn "swap size must be '0' or a number followed by M or G, e.g. 8G or 512M."
  done

  # Graphics. EWM launches from tty1 and loses the DRM-master race unless the
  # driver is forced into the initrd, so a wrong answer here is a black screen
  # on a machine whose owner has no other console. Asked, never assumed;
  # lspci only supplies the default.
  gpu_default="$(detect_gpu_default)"
  while :; do
    read -rp "Graphics [amd/intel/none] (${gpu_default}): " a
    GPU="${a:-$gpu_default}"
    validate_gpu "$GPU" && break
    warn "answer amd, intel, or none."
  done
}

# Fix (review round 1, finding 3): same reasoning as validate_hostname --
# reject here, at the prompt, rather than let a bad value reach the heredoc
# that writes host.nix.
# "0" is the no-swap sentinel and is the ONLY spelling of it that mkDisk
# understands. `[0-9]+` would accept "0G", which is not zero swap: mkDisk takes
# the swap branch and emits `size = "0G"` -- a zero-length partition, and disko
# destroys before it formats, so the failure lands with the disk already wiped.
# Hence [1-9][0-9]*: a positive number of M or G, or the literal "0".
# lib/disk.nix asserts the same shape, for callers that never see this prompt.
validate_swapsize() {
  printf '%s' "$1" | grep -qE '^(0|[1-9][0-9]*[MG])$'
}

# Same reasoning as validate_swapsize: reject at the prompt rather than let a
# bad value reach the heredoc that writes host.nix.
validate_gpu() {
  printf '%s' "$1" | grep -qE '^(amd|intel|none)$'
}

# The PCI vendor ID, not the model name. 0x1002 is AMD, 0x8086 is Intel. This
# is a two-value lookup and it only picks the DEFAULT answer — the user is
# still asked. emanix does not auto-detect hardware; see the spec's "Why there
# is no hardware auto-detection".
#
# Both vendors matching is not a tie to be broken, it is a machine we cannot
# answer for. The realistic both-matched box is an Intel iGPU driving the
# panel next to a discrete AMD card, where the compositor comes up on i915 --
# so an ordered case that fell through to `amd` was wrong in exactly the
# configuration that consulted it. Default to `none` and say why: asked, never
# guessed. (Intel + NVIDIA is unaffected; 10de matches neither arm.)
#
# The notice goes to STDERR on purpose. This function's stdout IS the default
# answer -- it is read through a command substitution -- so a line printed on
# stdout would become part of the value.
detect_gpu_default() {
  local vga has_amd=0 has_intel=0
  vga="$(lspci -nn 2>/dev/null | grep -iE 'vga|3d controller' || true)"
  case "$vga" in *1002:*) has_amd=1 ;; esac
  case "$vga" in *8086:*) has_intel=1 ;; esac

  if [ "$has_amd" = 1 ] && [ "$has_intel" = 1 ]; then
    printf 'Two GPU vendors were found (AMD and Intel). Which one drives the display is not something lspci can tell us, and guessing wrong here is a black screen -- please choose.\n' >&2
    echo none
  elif [ "$has_amd" = 1 ]; then
    echo amd
  elif [ "$has_intel" = 1 ]; then
    echo intel
  else
    echo none
  fi
}

write_generated_flake() {
  # Copied rather than `nix flake init -t`, which wants to run in a git repo
  # and writes into the current directory; inside a live ISO a copy is simpler
  # and has no network or git dependency.
  #
  # Called ONCE, into $1 -- a location OUTSIDE /mnt (disko's mount step would
  # hide anything written under /mnt before it runs). templates/default's
  # flake.nix pins nothing and ships no flake.lock, so a second call for the
  # same install would let nixos-install resolve its own independent lock --
  # disko could partition against one nixpkgs revision and nixos-install
  # build against a different one resolved minutes later. Generate once here,
  # let disko's evaluation produce the lock, then copy the whole (now locked)
  # tree forward -- see the call site.
  dest="$1"
  rm -rf "$dest" # safe to re-run: never trust a directory left by a prior attempt
  install -d -m 755 "$dest"
  cp -r "$REPO/templates/default/." "$dest/"
  chmod -R u+w "$dest"

  # Fix (review round 1, finding 3): SWAPSIZE is re-validated at the prompt
  # (interactive_prompts), but this is the one place it and DISK actually
  # reach a heredoc that gets fed to Nix -- and then to disko, which wipes a
  # disk. A defensive die here does not trust that every future caller of
  # this function went through the prompt.
  validate_swapsize "$SWAPSIZE" ||
    die "internal error: swap size '$SWAPSIZE' failed validation at generation time."
  validate_gpu "$GPU" ||
    die "internal error: graphics answer '$GPU' failed validation at generation time."
  [ -b "$DISK" ] ||
    die "'$DISK' is not a block device -- refusing to write it into host.nix."

  # `none` becomes a bare `null`, not the string "null": emanix.hardware.gpu is
  # a nullOr enum, so a quoted "null" typechecks as a string and then fails the
  # enum at evaluation — long after the disk has been repartitioned.
  case "$GPU" in
    none) gpu_nix="null" ;;
    *) gpu_nix="\"${GPU}\"" ;;
  esac

  cat > "$dest/host.nix" <<EOF
# Generated by fresh-emanix-install on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# The only file in this repo describing this machine.
{
  hostName = "${FLAKE_HOST}";
  device = "${DISK}";
  luks = ${LUKS};
  filesystem = "${FSTYPE}";
  swapSize = "${SWAPSIZE}";
  gpu = ${gpu_nix};

  # OPTIONAL. The name of a nixos-hardware module for this exact machine, e.g.
  # "lenovo-thinkpad-t14-amd-gen5". The installer does not guess it: see
  # https://github.com/NixOS/nixos-hardware for the list.
  hardwareModule = null;
}
EOF

  # mkHost always imports ./hardware-configuration.nix (a plain path is never
  # null), so the flake cannot evaluate without one -- and disko's evaluation
  # of this very directory is the first thing that needs it. A stub module
  # satisfies that; nixos-generate-config overwrites it with the real one
  # after disko has actually mounted the target, and before nixos-install
  # ever reads it. A local file changing after disko's evaluation does not
  # touch flake.lock, so it cannot re-open the pinning this function exists
  # to close.
  echo '{ }' > "$dest/hardware-configuration.nix"

  sed -i "s/username = \"youruser\";/username = \"${USERNAME}\";/" \
    "$dest/flake.nix"
  # Fix (review round 1, finding 2): sed exits 0 whether or not it matched
  # anything. If templates/default/flake.nix's placeholder ever drifts, this
  # would otherwise silently ship a flake whose username is still
  # "youruser" -- installing an account nobody can then log into, with
  # nothing in the installer's output to say so.
  grep -q "username = \"${USERNAME}\";" "$dest/flake.nix" ||
    die "failed to set the username in $dest/flake.nix -- the placeholder
('username = \"youruser\";') was not found to replace. templates/default/flake.nix
has drifted from what this installer expects; fix the template before
installing anything with it."
}

# Put the flake this machine was installed FROM into the new user's home.
#
# liveElisp (emanix.src.liveElisp, default true) makes ~/.config/emacs a set of
# out-of-store symlinks into a checkout, and EMANIX_BIN_DIR puts the consumer's
# bin/ on PATH. Nothing else creates either, so before this a freshly installed
# host booted to a dangling Emacs config and a PATH entry pointing at nothing.
#
# The ISO already stages the consuming repo at /etc/emanix/flake -- it is what
# this install was built from -- so this needs no network, no SSH key and no
# credential on a machine that has none yet. It is a copy, not a clone: git
# history comes with it if the staged copy has any, and if it does not, the
# user replaces it with a real clone once they have keys.
copy_staged_flake() {
  # ${EMANIX_TARGET_ROOT:-/mnt} rather than a bare /mnt so this function can be
  # sourced out and exercised against a fixture. Nothing in the installer sets
  # it; the default IS the production path.
  local dest="${EMANIX_TARGET_ROOT:-/mnt}/home/$1/dotfiles"
  [ -d "$REPO" ] || return 0

  # $REPO can be the emanix distro's OWN tree rather than a consuming flake.
  # That repo BUILDS the installer, it does not consume it, and it holds no
  # dotfiles for any user -- copying it into $dest would silently plant the
  # distro's source tree where a personal config belongs.
  #
  # Detected by CONTENT first, because provenance misses the case that
  # actually ships. The realpath comparison below only fires for a maintainer
  # running this script straight out of a clone: on an ISO the script lives in
  # /nix/store/.../bin, so $self_repo is a store path that can never equal
  # $REPO. But installer/iso.nix declares emanix.installer.flake with a
  # default of `../.` -- the distro itself -- and interactive mode REQUIRES a
  # flake carrying templates/default, which in practice only the distro has.
  # So the stock-ISO interactive install, the only mode a stranger can use, is
  # precisely where $REPO IS the distro, and it walked straight past a
  # provenance check.
  #
  # templates/default alone is not enough (a consuming flake could ship
  # templates of its own), so it must be paired with a file only the tree that
  # BUILDS this installer has. The realpath check is kept as well: it costs
  # nothing and still catches a distro clone whose layout has drifted.
  local self_repo repo_rp self_rp
  self_repo="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null)")")"
  repo_rp="$(realpath "$REPO" 2>/dev/null || true)"
  self_rp="$(realpath "$self_repo" 2>/dev/null || true)"
  if { [ -d "$REPO/templates/default" ] &&
       { [ -f "$REPO/lib/disk.nix" ] ||
         [ -f "$REPO/installer/fresh-emanix-install" ]; }; } ||
     { [ -n "$repo_rp" ] && [ "$repo_rp" = "$self_rp" ]; }; then
    warn "$REPO is the emanix distro itself, not a consuming flake -- nothing to stage into $dest."
    return 0
  fi

  # -e alone follows symlinks, so a DANGLING symlink at $dest reads as absent
  # and slips past this guard -- cp -a then refuses to write through it (good,
  # nothing gets clobbered) but as an uncaught error under set -e, aborting
  # the whole install instead of the graceful skip intended here. -L catches
  # the dangling case too.
  { [ -e "$dest" ] || [ -L "$dest" ]; } &&
    { warn "$dest already exists — leaving it alone."; return 0; }
  say "Copying the flake into ${dest#"${EMANIX_TARGET_ROOT:-/mnt}"}"
  # install -d names $dest ITSELF -- the new directory -- never dirname
  # "$dest", which is /mnt/home/$1, the account's HOME DIRECTORY that
  # nixos-install already created. install -d re-chmods an existing directory
  # to -m's mode regardless of what NixOS gave it, so a line naming the parent
  # would silently widen the new account's home to 755 as a side effect of
  # what reads like a harmless no-op.
  #
  # `cp -aL "$REPO/."`, NOT `cp -a "$REPO"`. On the ISO $REPO is
  # /etc/emanix/flake, and NixOS renders a directory-source /etc entry as a
  # SYMLINK (/etc/emanix/flake -> /etc/static/emanix/flake), exactly like
  # /etc/dbus-1. `[ -d "$REPO" ]` follows it and passes; `cp -a` implies -d and
  # never dereferences, so it would reproduce the SYMLINK at $dest -- pointing
  # at /etc/static/emanix/flake, a path that does not exist on the INSTALLED
  # system. The result is a dangling ~/dotfiles: EMANIX_BIN_DIR still broken,
  # liveElisp's ~/.config/emacs still dangling, and -- worst of it -- ~/dotfiles
  # now "exists", so both the guard above and the deferred emanix-firstboot
  # clone skip it forever. `chown -R` over a dangling symlink even exits 0, so
  # the warning below would never fire either: silent, total failure of the
  # one thing this function exists to do.
  #
  # chmod -R u+w for the same reason write_generated_flake does it after its
  # own copy: a staged tree comes from the nix store, which is dr-xr-xr-x /
  # -r--r--r--, so the user could not edit their own dotfiles or `git pull`.
  # It is not optional here -- cp -aL puts the SOURCE directory's mode on
  # $dest as well, so install -d's 755 does not survive the copy.
  install -d -m 755 "$dest"
  cp -aL "$REPO/." "$dest/"
  chmod -R u+w "$dest"
  # The account does not exist on THIS system, only in the chroot, so chown by
  # name inside it (nixos-install already created the account there).
  # Non-fatal -- the machine IS installed at this point, and aborting the
  # whole run over a chown is worse than leaving a paths issue for the user to
  # fix -- but it must not fail SILENTLY: an operator who never sees this
  # would be left with a checkout owned by root and no dotfiles they can
  # write, no reboot warning of why.
  if ! nixos-enter --root "${EMANIX_TARGET_ROOT:-/mnt}" -c "chown -R '$1':users '/home/$1/dotfiles'"; then
    warn "could not chown ${dest#"${EMANIX_TARGET_ROOT:-/mnt}"} to $1:users -- it is left owned by
root, and $1 cannot write their own dotfiles checkout until this is fixed.
Log in and run: sudo chown -R $1:users ~/dotfiles"
  fi
}

# --- Preflight ----------------------------------------------------------------
resolve_repo

# known_hosts() is a single failing command under set -e: a bare
# `KNOWN="$(known_hosts)"` would let a nix-eval failure kill the script right
# here, before the die below ever runs. `|| true` keeps that failure a normal
# value (empty $KNOWN) so the intended error message is the one that fires.
KNOWN="$(known_hosts)" || true
[ -n "$KNOWN" ] || die "could not enumerate hosts in $REPO — is it a valid flake?"

# $KNOWN is a space-separated list from known_hosts(); read it into an array
# so testing membership below needs no unquoted (word-splitting) expansion.
read -ra KNOWN_ARR <<<"$KNOWN"

if [ -z "$FLAKE_HOST" ]; then
  MODE=interactive
elif ! printf '%s\n' "${KNOWN_ARR[@]}" | grep -qxF "$FLAKE_HOST"; then
  MODE=interactive
fi

if [ "$MODE" = interactive ]; then
  if [ -n "$FLAKE_HOST" ] && ! validate_hostname "$FLAKE_HOST"; then
    die "hostname '$FLAKE_HOST' is not a valid hostname (RFC 1123: lowercase
letters, digits and hyphens, not starting or ending with a hyphen, 1-63 chars)."
  fi
fi

if [ "$MODE" = prestaged ]; then
  resolve_keys
else
  KEY_DIR="" # a new host has no staged key; one is generated fresh below.
fi
resolve_disk

CHECK_REPO=n
CHECK_KEYS=n
CHECK_UEFI=n
CHECK_NET=n
CHECK_DISK=n
SB_STATUS="off"

# Interactive mode installs a host this flake has never heard of: its key is
# generated fresh during the (destructive) install below, not staged, so
# there is nothing to verify against a recipient. This has to be set HERE,
# before the --check-only branch below runs its own $FAILED aggregation --
# setting it only after that branch returns (as the interactive_prompts
# block further down used to) left CHECK_KEYS=n from the defaults above in
# effect for --check-only, which always reported "missing: keys" even
# though nothing was truly missing. That made --check-only -- the one
# non-destructive command a stranger has, and the one the ISO's own
# /etc/issue advertises -- always fail on exactly the installs it exists to
# preview.
if [ "$MODE" = interactive ]; then
  CHECK_KEYS=y
fi

[ -f "$REPO/flake.nix" ] && CHECK_REPO=y

# Host key fingerprint. Source of truth pre-Part-II: the agenix recipient in
# secrets/secrets.nix. Post-Part-II (no secrets.nix): the repo's committed
# keys/<host>_host_ed25519.pub — flake.nix's agenix-rekey wiring
# (age.rekey.hostPubkey = ./keys/<host>_host_ed25519.pub) encrypts every
# secret to exactly that file, so it — not the staged pair's own internal
# consistency — is the actual recipient this check must confirm against.
# Either way a mismatch fails closed.
if [ -n "$KEY_DIR" ]; then
  HOST_KEY="$KEY_DIR/${FLAKE_HOST}_host_ed25519"
  if [ -f "$HOST_KEY" ] && [ -f "$HOST_KEY.pub" ]; then
    if [ -f "$REPO/secrets/secrets.nix" ]; then
      host_pub="$(sed -nE "s/.*${FLAKE_HOST}[[:space:]]*=[[:space:]]*\"(ssh-ed25519 [^\"]+)\".*/\\1/p" "$REPO/secrets/secrets.nix")"
      if [ -n "$host_pub" ]; then
        want_fp="$(printf '%s\n' "$host_pub" | ssh-keygen -lf - | awk '{print $2}')"
        have_fp="$(ssh-keygen -lf "$HOST_KEY.pub" | awk '{print $2}')"
        [ "$want_fp" = "$have_fp" ] && CHECK_KEYS=y
      fi
    else
      # No secrets.nix (agenix-rekey era): the repo's committed
      # keys/<host>_host_ed25519.pub is the real recipient (see comment
      # above). Compare fingerprints, not file bytes — a staged .pub can
      # differ from the committed one in comment/trailing whitespace while
      # being the same key.
      REPO_PUB="$REPO/keys/${FLAKE_HOST}_host_ed25519.pub"
      if [ -f "$REPO_PUB" ]; then
        want_fp="$(ssh-keygen -lf "$REPO_PUB" | awk '{print $2}')"
        have_fp="$(ssh-keygen -lf "$HOST_KEY.pub" | awk '{print $2}')"
        if [ "$want_fp" = "$have_fp" ]; then
          CHECK_KEYS=y
        else
          warn "staged key for $FLAKE_HOST does NOT match the repo's recipient — agenix would fail to decrypt on first boot."
          warn "  repo recipient ($REPO_PUB):   $want_fp"
          warn "  staged key     ($HOST_KEY.pub): $have_fp"
        fi
      else
        warn "no $REPO_PUB in this repo — cannot verify the staged key against a recipient."
      fi
    fi
  fi
fi

if [ -d /sys/firmware/efi ]; then CHECK_UEFI=y; fi

if command -v bootctl >/dev/null 2>&1 && bootctl status 2>/dev/null | grep -qi "Secure Boot: enabled"; then
  SB_STATUS="ENABLED"
fi

if ping -c1 -W4 cache.nixos.org >/dev/null 2>&1; then CHECK_NET=y; fi

[ -n "$DISK" ] && [ -b "$DISK" ] && CHECK_DISK=y

print_checklist() {
  # FLAKE_HOST is still empty here when --check-only was run with no
  # argument at all (interactive_prompts, which asks for one, only runs in
  # the destructive path below) -- print something meaningful instead of a
  # blank where the hostname belongs.
  printf '\n\033[1;36memanix installer preflight — %s\033[0m\n' \
    "${FLAKE_HOST:-a new host (hostname not chosen yet)}"
  printf '  repo        %s %s\n' "$([ "$CHECK_REPO" = y ] && echo ✓ || echo ✗)" "$REPO"
  if [ "$MODE" = interactive ] && [ "$CHECK_KEYS" = y ]; then
    printf '  keys        %s generated fresh during install (new host, no secrets to decrypt)\n' ✓
  elif [ "$CHECK_KEYS" = y ]; then
    printf '  keys        %s %s/%s_host_ed25519\n' ✓ "$KEY_DIR" "$FLAKE_HOST"
  else
    printf '  keys        %s (none staged for %s)\n' ✗ "$FLAKE_HOST"
  fi
  printf '  UEFI        %s\n' "$([ "$CHECK_UEFI" = y ] && echo ✓ || echo ✗)"
  printf '  network     %s\n' "$([ "$CHECK_NET" = y ] && echo ✓ || echo ✗)"
  printf '  disk        %s %s\n' "$([ "$CHECK_DISK" = y ] && echo ✓ || echo ✗)" "${DISK:-none detected}"
  printf '  Secure Boot %s\n' "$SB_STATUS"
}

FAILED=""
[ "$CHECK_REPO" = y ] || FAILED="$FAILED repo"
[ "$CHECK_KEYS" = y ] || FAILED="$FAILED keys"
[ "$CHECK_UEFI" = y ] || FAILED="$FAILED UEFI"
[ "$CHECK_NET" = y ]  || FAILED="$FAILED network"
[ "$CHECK_DISK" = y ] || FAILED="$FAILED disk"

if [ "$CHECK_ONLY" -eq 1 ]; then
  print_checklist
  [ -z "$FAILED" ] && { say "check-only: all good."; exit 0; }
  die "check-only: missing:$FAILED"
fi

# Anything below this line is destructive — check-only never gets here.
[ "$(id -u)" -eq 0 ] || die "run as root (sudo)."

if [ "$MODE" = interactive ]; then
  interactive_prompts
  # CHECK_KEYS=y was already set above (before the --check-only branch).
  # interactive_prompts already established network connectivity itself (or
  # died trying), which does not gate an interactive install the way it
  # gates the pre-staged path.
  CHECK_NET=y
  FAILED=""
  [ "$CHECK_REPO" = y ] || FAILED="$FAILED repo"
  [ "$CHECK_UEFI" = y ] || FAILED="$FAILED UEFI"
  [ "$CHECK_DISK" = y ] || FAILED="$FAILED disk"
fi

print_checklist
[ -z "$FAILED" ] || die "preflight failed:$FAILED"

if [ "$SB_STATUS" = "ENABLED" ]; then
  warn "Secure Boot is ENABLED. systemd-boot is unsigned — the installed system will NOT boot."
  warn "Disable Secure Boot in firmware before rebooting into the installed system."
  read -rp "Continue the install anyway? [y/N] " a
  [ "$a" = y ] || die "aborted — disable Secure Boot first."
fi

# Cross-check the device disko will ACTUALLY erase against the one the prompt
# is about to name. These are not the same thing by construction: disko is
# invoked with --flake, never with $DISK, so it partitions whatever
# disko.devices.disk.main.device evaluates to. $DISK only drives the preflight
# display and the confirmation text.
#
# Ask the FLAKE, not a file. This grepped a per-host disko layout file under
# $REPO/ioshi/hi-hardware/disko/ (named after $FLAKE_HOST) until 2026-09-05,
# when a consuming repo moved its layout inline and the grep silently started
# returning nothing -- `|| true` swallowed it, $declared went empty, and the
# mismatch branch became unreachable. A consumer's file layout is not this
# script's business; the evaluated config is.
#
# Only for MODE=prestaged: a prestaged host's disko layout already exists in
# $REPO, hardcoded, independent of whatever $DISK the preflight just picked --
# that is exactly the gap this check closes. An interactive (new) host has no
# nixosConfigurations entry in $REPO at all (that is known_hosts()'s
# definition of "unknown"), so there is nothing yet to ask; write_generated_flake
# below bakes `device = "${DISK}";` from this same $DISK into the host.nix it
# writes, so for a generated host the device disko will use IS $DISK, by
# construction, not by cross-check.
if [ "$MODE" = prestaged ]; then
  declared="$(nix eval --raw \
    "$REPO#nixosConfigurations.$FLAKE_HOST.config.disko.devices.disk.main.device" \
    2>/dev/null || true)"

  if [ -z "$declared" ]; then
    die "could not read the disko device for $FLAKE_HOST from $REPO.
Refusing to continue: without it the confirmation below would name a disk this
script cannot prove disko will use. If this host genuinely has no disko layout,
it cannot be installed by this script."
  fi

  if [ "$declared" != "$DISK" ]; then
    die "TARGET MISMATCH — refusing to continue.
  disko will erase : $declared   (from $FLAKE_HOST's flake config)
  preflight picked : $DISK
Re-run with --disk $declared if that is the disk you mean, or fix the layout.
This is fatal rather than a prompt: the next step destroys a disk, and a
warning here is one the operator has been trained to accept."
  fi
fi

# Prestaged: $DISK and $declared are proven equal by the cross-check above.
# Interactive (new host): the device disko will use is baked from this same
# $DISK by write_generated_flake below, so naming $DISK here is still naming
# the disk disko will erase.
say "Target disk"
lsblk -d -o NAME,SIZE,MODEL,TRAN "$DISK" || die "$DISK not present."
printf '\033[1;31m>>> This ERASES %s completely. <<<\033[0m\n' "$DISK"
read -rp "Type 'yes' to wipe $DISK and install $FLAKE_HOST: " ok
[ "$ok" = yes ] || die "aborted."

# For a pre-staged host $REPO already knows it. For a generated one nothing
# does yet -- write_generated_flake writes it ONCE, to a stable /tmp path
# outside /mnt (the live ISO's /tmp is tmpfs and is not shadowed by disko's
# mount, unlike anything under /mnt itself).
#
# Fix (review round 1, finding 1): templates/default/flake.nix pins nothing
# and ships no flake.lock, so writing the generated flake twice -- once for
# disko, once for nixos-install -- would let each call resolve its own
# independent lock: disko could partition against one nixpkgs/emanix/disko
# revision and nixos-install then build against a DIFFERENT one resolved
# minutes later. Generating once and locking it explicitly, below, before
# disko ever runs, is what keeps both steps pinned to identical inputs.
FLAKE_REF="$REPO#$FLAKE_HOST"
GEN_STAGE="/tmp/emanix-generated"
if [ "$MODE" = interactive ]; then
  FLAKE_REF="$GEN_STAGE#$FLAKE_HOST"
  write_generated_flake "$GEN_STAGE"

  # Fix (review round 2, finding 1): locked explicitly and up front, rather
  # than assumed as a side effect of disko's own evaluation. `nix flake lock`
  # resolves INPUTS only -- it does not evaluate outputs -- so the missing
  # hardware-configuration.nix (still just the '{ }' stub at this point)
  # does not obstruct it. This also means an unreachable input or a broken
  # template surfaces here, before the disk is touched, rather than as a
  # build failure partway through disko or nixos-install.
  say "Locking the generated flake's inputs"
  nix flake lock "$GEN_STAGE" ||
    die "could not lock $GEN_STAGE (nix flake lock failed) -- an unreachable
input or a broken templates/default. Fix this before anything touches the
disk."
fi

say "Partitioning + formatting with disko"
if command -v disko >/dev/null 2>&1; then
  disko --mode destroy,format,mount --flake "$FLAKE_REF"
else
  nix run github:nix-community/disko/latest -- \
    --mode destroy,format,mount --flake "$FLAKE_REF"
fi

if [ "$MODE" = interactive ]; then
  say "Generating a fresh host key (a new host has no secrets to decrypt)"
  install -d -m 755 /mnt/etc/ssh
  # Fix (review round 1, finding 4): ssh-keygen prompts to overwrite an
  # existing target file even with -N "" -- fatal on an unattended install,
  # since nobody is watching the console to answer it. /mnt/etc/ssh is
  # freshly mounted and should not already hold a key, but rm -f makes the
  # target unambiguously fresh rather than trusting that.
  rm -f /mnt/etc/ssh/ssh_host_ed25519_key /mnt/etc/ssh/ssh_host_ed25519_key.pub
  ssh-keygen -q -t ed25519 -N "" -C "$FLAKE_HOST" -f /mnt/etc/ssh/ssh_host_ed25519_key

  # Copy the ALREADY-LOCKED tree forward rather than regenerating it: `nix
  # flake lock` above produced $GEN_STAGE/flake.lock, and carrying that file
  # forward is what keeps nixos-install building against the exact revisions
  # disko just partitioned against, instead of re-resolving (and possibly
  # drifting).
  install -d -m 755 /mnt/etc/nixos
  cp -r "$GEN_STAGE/." /mnt/etc/nixos/
  # Fix (review round 2, finding 1): this no longer hopes disko produced a
  # lock as a side effect -- it confirms the copy carried the one `nix flake
  # lock` deliberately made above. Failing here would mean the copy itself
  # went wrong, not that locking was skipped.
  [ -s /mnt/etc/nixos/flake.lock ] ||
    die "the copy from $GEN_STAGE to /mnt/etc/nixos did not carry a
flake.lock, even though nix flake lock succeeded against $GEN_STAGE above --
refusing to install unpinned. Something is wrong with the copy step; do not
proceed without finding out why."
  FLAKE_REF="/mnt/etc/nixos#$FLAKE_HOST"

  # Only now generate hardware-configuration.nix -- overwriting the stub --
  # since /mnt is finally the real target, not the live ISO's own overlay.
  # A local file changing after the lock above is fine; it is not an input.
  #
  # --no-filesystems: without it, nixos-generate-config emits `fileSystems`
  # AND `swapDevices` entries for the disks it finds already mounted at
  # /mnt -- i.e. the ones disko just partitioned and mounted moments ago --
  # at normal priority. disko.nix (via emanix.lib.mkDisk, emanix's
  # lib/disk.nix) already defines both from the SAME mounts, so
  # nixos-install then fails with
  # "The option `fileSystems."/".device' has conflicting definition
  # values", after the disk has already been wiped. One flag suppresses
  # both kinds of entry (nixos-generate-config's own --help: "Omit file
  # systems (in particular the ones for / and /boot) and swap devices from
  # the hardware configuration"), so no separate swapDevices handling is
  # needed even though the template's disko.nix can add a swap partition --
  # --no-filesystems already covers it.
  nixos-generate-config --show-hardware-config --no-filesystems --root /mnt \
    > /mnt/etc/nixos/hardware-configuration.nix
else
  say "Injecting the $FLAKE_HOST host key (so agenix decrypts on first boot)"
  install -d -m 755 /mnt/etc/ssh
  install -m 600 "$HOST_KEY"     /mnt/etc/ssh/ssh_host_ed25519_key
  install -m 644 "$HOST_KEY.pub" /mnt/etc/ssh/ssh_host_ed25519_key.pub
fi

say "Installing $FLAKE_HOST — builds the system closure, a few minutes"
nixos-install --flake "$FLAKE_REF" --no-root-password

if [ "$MODE" = prestaged ]; then
  # The username is defined by the consuming flake's host config. Probe the
  # mounted home dir (the only user that exists at this point), else prompt.
  # Interactive mode already has USERNAME from interactive_prompts.
  #
  # `|| true`: this is a bare command substitution under `set -e`, and a
  # nixos-enter failure here would otherwise kill the installer AFTER a
  # successful nixos-install -- the most expensive possible moment.
  USERNAME="$(nixos-enter --root /mnt -c 'ls /home | head -1' 2>/dev/null || true)"
  while ! validate_username "${USERNAME:-}"; do
    warn "could not determine the account name from /mnt/home."
    read -rp "Username for this machine's account: " USERNAME
  done
fi

# Belt and braces: interactive mode set USERNAME long before the disk was
# touched, so a bug upstream would surface here rather than as a bare `passwd`.
validate_username "$USERNAME" ||
  die "internal error: refusing to run passwd with username '$USERNAME'.
An empty or malformed name here would set ROOT's password in the chroot while
the real account stays passwordless."

say "Set a password for $USERNAME"
nixos-enter --root /mnt -c "passwd '$USERNAME'"

say "$FLAKE_HOST installed."
copy_staged_flake "$USERNAME"
# Anything that still touches the mounted target (e.g. copying a directory
# into the installed system) belongs ABOVE this line -- once INSTALL_OK is set,
# a failure past this point no longer unmounts /mnt for a retry.
INSTALL_OK=1
echo "After reboot (remove the USB), log in and run:  emanix-firstboot"
[ "$MODE" = interactive ] &&
  echo "Then run emanix-init to turn /etc/nixos into a git repo you own."
read -rp "Reboot now? [y/N] " r
[ "$r" = y ] && reboot
