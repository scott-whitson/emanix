#!/usr/bin/env bash
# fresh-eminix-install — one-shot NixOS installer for an eminix host.
#
# Usage (in the eminix installer ISO, or any NixOS live ISO):
#   sudo fresh-eminix-install [host] [--disk /dev/X] [--check-only]
#
# The host is required. The repo is located automatically (EMINIX_REPO, the
# script's parent, /etc/eminix/flake on the ISO, or common mounts); the
# host key comes from the baked ISO keys, a staged <host>-keys/ dir beside the
# repo, or a prompt; the target disk is auto-detected (largest non-removable
# device with no mounted partitions) unless --disk is given. --check-only
# prints the preflight checklist and exits without touching anything.
#
# Automates: preflight -> disko -> inject host key -> nixos-install
# -> set password -> reboot. Full context: docs/ioshi/eminix-install.md.
# Spec: docs/superpowers/specs/2026-08-15-eminix-installer-iso-design.md
set -euo pipefail

say()  { printf '\n\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWARNING:\033[0m %s\n' "$*"; }
die()  { printf '\n\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# --- Args: [host] [--disk /dev/X | positional] [--check-only] ----------------
FLAKE_HOST=""
DISK=""
CHECK_ONLY=0
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  a="${args[$i]}"
  case "$a" in
    --check-only) CHECK_ONLY=1 ;;
    --disk)
      i=$((i + 1))
      DISK="${args[$i]:-}"
      [ -n "$DISK" ] || die "--disk needs a value."
      ;;
    --disk=*) DISK="${a#--disk=}" ;;
    -*) die "unknown option: $a" ;;
    *)
      if [ -z "$FLAKE_HOST" ]; then FLAKE_HOST="$a"; else DISK="${DISK:-$a}"; fi
      ;;
  esac
  i=$((i + 1))
done
[ -n "$FLAKE_HOST" ] || die "usage: fresh-eminix-install <host> [--disk /dev/X] [--check-only]"

# --- Locate the repo ----------------------------------------------------------
resolve_repo() {
  if [ -n "${EMINIX_REPO:-}" ] && [ -f "$EMINIX_REPO/flake.nix" ]; then
    REPO="$EMINIX_REPO"
    return
  fi
  SELF="$(realpath "${BASH_SOURCE[0]}")"
  if [ -f "$(dirname "$(dirname "$SELF")")/flake.nix" ]; then
    REPO="$(dirname "$(dirname "$SELF")")"
    return
  fi
  for cand in /etc/eminix/flake /mnt/flake /run/media/*/*/flake /media/*/flake; do
    # shellcheck disable=SC2086 # globs are the point of the bounded scan
    [ -f "$cand/flake.nix" ] && { REPO="$cand"; return; }
  done
  die "could not locate the eminix flake. Tried: \$EMINIX_REPO, the script's
parent, /etc/eminix/flake, /mnt/flake, /run/media/*/*/flake,
/media/*/flake. Set EMINIX_REPO to the repo path and re-run."
}

# --- Locate the host key (baked ISO -> staged dir -> prompt) ------------------
# Sets KEY_DIR, or leaves it empty (check-only reports; real mode dies later).
resolve_keys() {
  KEY_DIR=""
  if [ -f "/etc/eminix/keys/${FLAKE_HOST}_host_ed25519" ] &&
    [ -f "/etc/eminix/keys/${FLAKE_HOST}_host_ed25519.pub" ]; then
    KEY_DIR=/etc/eminix/keys
    return
  fi
  if [ -f "$(dirname "$REPO")/${FLAKE_HOST}-keys/${FLAKE_HOST}_host_ed25519" ]; then
    KEY_DIR="$(dirname "$REPO")/${FLAKE_HOST}-keys"
    return
  fi
  if [ "$CHECK_ONLY" -eq 0 ]; then
    read -rp "Directory holding ${FLAKE_HOST}_host_ed25519(.pub): " kd
    if [ -n "$kd" ] && [ -f "$kd/${FLAKE_HOST}_host_ed25519" ]; then KEY_DIR="$kd"; fi
  fi
}

# --- Target disk: largest non-removable, RW, with no mounted partitions -------
resolve_disk() {
  if [ -n "$DISK" ]; then return; fi
  best=""
  best_size=0
  for name in $(lsblk -bndo NAME); do
    [ "$(lsblk -bndo RO "/dev/$name")" = "0" ] || continue        # skip read-only
    [ "$(lsblk -bndo TRAN "/dev/$name")" = "usb" ] && continue    # skip the stick
    lsblk -no MOUNTPOINTS "/dev/$name" | grep -q . && continue    # skip mounted disks
    size="$(lsblk -bndo SIZE "/dev/$name")"
    if [ "${size:-0}" -gt "$best_size" ]; then best="$name"; best_size="$size"; fi
  done
  if [ -n "$best" ]; then DISK="/dev/$best"; fi
}

# --- Preflight ----------------------------------------------------------------
resolve_repo
resolve_keys
resolve_disk

CHECK_REPO=n
CHECK_KEYS=n
CHECK_UEFI=n
CHECK_NET=n
CHECK_DISK=n
SB_STATUS="off"

[ -f "$REPO/flake.nix" ] && CHECK_REPO=y

# Host key fingerprint. Source of truth pre-Part-II: the agenix recipient in
# secrets/secrets.nix. Post-Part-II (no secrets.nix): the repo's committed
# keys/<host>_host_ed25519.pub — flake.nix's agenix-rekey wiring
# (age.rekey.hostPubkey = ./keys/<host>_host_ed25519.pub) encrypts every
# secret to exactly that file, so it — not the staged pair's own internal
# consistency — is the actual recipient this check must confirm against.
# Either way a mismatch fails closed.
if [ -n "$KEY_DIR" ]; then
  HOST_KEY="$KEY_DIR/${FLAKE_HOST}_host_ed25519"
  if [ -f "$HOST_KEY" ] && [ -f "$HOST_KEY.pub" ]; then
    if [ -f "$REPO/secrets/secrets.nix" ]; then
      host_pub="$(sed -nE "s/.*${FLAKE_HOST}[[:space:]]*=[[:space:]]*\"(ssh-ed25519 [^\"]+)\".*/\\1/p" "$REPO/secrets/secrets.nix")"
      if [ -n "$host_pub" ]; then
        want_fp="$(printf '%s\n' "$host_pub" | ssh-keygen -lf - | awk '{print $2}')"
        have_fp="$(ssh-keygen -lf "$HOST_KEY.pub" | awk '{print $2}')"
        [ "$want_fp" = "$have_fp" ] && CHECK_KEYS=y
      fi
    else
      # No secrets.nix (agenix-rekey era): the repo's committed
      # keys/<host>_host_ed25519.pub is the real recipient (see comment
      # above). Compare fingerprints, not file bytes — a staged .pub can
      # differ from the committed one in comment/trailing whitespace while
      # being the same key.
      REPO_PUB="$REPO/keys/${FLAKE_HOST}_host_ed25519.pub"
      if [ -f "$REPO_PUB" ]; then
        want_fp="$(ssh-keygen -lf "$REPO_PUB" | awk '{print $2}')"
        have_fp="$(ssh-keygen -lf "$HOST_KEY.pub" | awk '{print $2}')"
        if [ "$want_fp" = "$have_fp" ]; then
          CHECK_KEYS=y
        else
          warn "staged key for $FLAKE_HOST does NOT match the repo's recipient — agenix would fail to decrypt on first boot."
          warn "  repo recipient ($REPO_PUB):   $want_fp"
          warn "  staged key     ($HOST_KEY.pub): $have_fp"
        fi
      else
        warn "no $REPO_PUB in this repo — cannot verify the staged key against a recipient."
      fi
    fi
  fi
fi

if [ -d /sys/firmware/efi ]; then CHECK_UEFI=y; fi

if command -v bootctl >/dev/null 2>&1 && bootctl status 2>/dev/null | grep -qi "Secure Boot: enabled"; then
  SB_STATUS="ENABLED"
fi

if ping -c1 -W4 cache.nixos.org >/dev/null 2>&1; then CHECK_NET=y; fi

[ -n "$DISK" ] && [ -b "$DISK" ] && CHECK_DISK=y

print_checklist() {
  printf '\n\033[1;36meminix installer preflight — %s\033[0m\n' "$FLAKE_HOST"
  printf '  repo        %s %s\n' "$([ "$CHECK_REPO" = y ] && echo ✓ || echo ✗)" "$REPO"
  if [ "$CHECK_KEYS" = y ]; then
    printf '  keys        %s %s/%s_host_ed25519\n' ✓ "$KEY_DIR" "$FLAKE_HOST"
  else
    printf '  keys        %s (none staged for %s)\n' ✗ "$FLAKE_HOST"
  fi
  printf '  UEFI        %s\n' "$([ "$CHECK_UEFI" = y ] && echo ✓ || echo ✗)"
  printf '  network     %s\n' "$([ "$CHECK_NET" = y ] && echo ✓ || echo ✗)"
  printf '  disk        %s %s\n' "$([ "$CHECK_DISK" = y ] && echo ✓ || echo ✗)" "${DISK:-none detected}"
  printf '  Secure Boot %s\n' "$SB_STATUS"
}

FAILED=""
[ "$CHECK_REPO" = y ] || FAILED="$FAILED repo"
[ "$CHECK_KEYS" = y ] || FAILED="$FAILED keys"
[ "$CHECK_UEFI" = y ] || FAILED="$FAILED UEFI"
[ "$CHECK_NET" = y ]  || FAILED="$FAILED network"
[ "$CHECK_DISK" = y ] || FAILED="$FAILED disk"

if [ "$CHECK_ONLY" -eq 1 ]; then
  print_checklist
  [ -z "$FAILED" ] && { say "check-only: all good."; exit 0; }
  die "check-only: missing:$FAILED"
fi

# Anything below this line is destructive — check-only never gets here.
[ "$(id -u)" -eq 0 ] || die "run as root (sudo)."

print_checklist
[ -z "$FAILED" ] || die "preflight failed:$FAILED"

if [ "$SB_STATUS" = "ENABLED" ]; then
  warn "Secure Boot is ENABLED. systemd-boot is unsigned — the installed system will NOT boot."
  warn "Disable Secure Boot in firmware before rebooting into the installed system."
  read -rp "Continue the install anyway? [y/N] " a
  [ "$a" = y ] || die "aborted — disable Secure Boot first."
fi

# Cross-check the disko layout's declared device against the auto-detected one
# (the layout is authoritative; a mismatch is a VM/override or a wrong pick).
declared="$(grep -oE 'device = "[^"]+"' "$REPO/ioshi/hi-hardware/disko/$FLAKE_HOST.nix" 2>/dev/null | head -1 | cut -d'"' -f2 || true)"
if [ -n "$declared" ] && [ "$declared" != "$DISK" ]; then
  warn "disko layout for $FLAKE_HOST declares $declared but the target is $DISK."
  read -rp "Continue? [y/N] " a
  [ "$a" = y ] || die "aborted."
fi

say "Target disk"
lsblk -d -o NAME,SIZE,MODEL,TRAN "$DISK" || die "$DISK not present."
printf '\033[1;31m>>> This ERASES %s completely. <<<\033[0m\n' "$DISK"
read -rp "Type 'yes' to wipe $DISK and install $FLAKE_HOST: " ok
[ "$ok" = yes ] || die "aborted."

say "Partitioning + formatting with disko"
if command -v disko >/dev/null 2>&1; then
  disko --mode destroy,format,mount --flake "$REPO#$FLAKE_HOST"
else
  nix run github:nix-community/disko/latest -- \
    --mode destroy,format,mount --flake "$REPO#$FLAKE_HOST"
fi

say "Injecting the $FLAKE_HOST host key (so agenix decrypts on first boot)"
install -d -m 755 /mnt/etc/ssh
install -m 600 "$HOST_KEY"     /mnt/etc/ssh/ssh_host_ed25519_key
install -m 644 "$HOST_KEY.pub" /mnt/etc/ssh/ssh_host_ed25519_key.pub

say "Installing $FLAKE_HOST — builds the system closure, a few minutes"
nixos-install --flake "$REPO#$FLAKE_HOST" --no-root-password

# The username is defined by the consuming flake's host config. Probe the
# mounted home dir (the only user that exists at this point), else prompt.
USERNAME="$(nixos-enter --root /mnt -c 'ls /home | head -1' 2>/dev/null)"
if [ -z "$USERNAME" ]; then
  read -rp "Username: " USERNAME
fi
say "Set a password for $USERNAME"
nixos-enter --root /mnt -c "passwd $USERNAME"

say "$FLAKE_HOST installed."
echo "After reboot (remove the USB), log in and run:  eminix-firstboot"
read -rp "Reboot now? [y/N] " r
[ "$r" = y ] && reboot
