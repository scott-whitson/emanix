#!/usr/bin/env bash
set -euo pipefail

if [[ -x /usr/bin/obsidian ]]; then
	exec /usr/bin/obsidian "$@"
fi

if [[ -x /opt/Obsidian/obsidian ]]; then
	exec /opt/Obsidian/obsidian "$@"
fi

if command -v flatpak &>/dev/null; then
	exec flatpak run md.obsidian.Obsidian "$@"
fi

echo "obsidian: no app binary found" >&2
exit 127
