#!/usr/bin/env bash
# fragpaper-launch — one-shot launcher for manual use or systemd.
# Kills stale instances, then execs fragpaper directly.
#
# Usage: fragpaper-launch [--kill]
#   --kill  only kill stale instances, don't start

set -u

FRAGPAPER_SRC="${FRAGPAPER_SRC:-$HOME/.local/share/fragpaper}"
FRAGPAPER_BIN="${FRAGPAPER_BIN:-$HOME/.local/opt/fragpaper/bin/fragpaper}"

# ── Kill stale instances ────────────────────────────────────────────────────
kill_stale() {
    local pids
    pids=$(pgrep -f "fragpaper" 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
        echo "fragpaper-launch: killing stale: $pids" >&2
        echo "$pids" | xargs kill 2>/dev/null
        sleep 1
        pids=$(pgrep -f "fragpaper" 2>/dev/null || true)
        [[ -n "$pids" ]] && echo "$pids" | xargs kill -9 2>/dev/null && sleep 1
    fi
}

kill_stale

[[ "${1:-}" == "--kill" ]] && exit 0

# ── Find binary ─────────────────────────────────────────────────────────────
bin=""
if [[ -x "$FRAGPAPER_BIN" ]]; then
    bin="$FRAGPAPER_BIN"
elif command -v fragpaper >/dev/null 2>&1; then
    bin="$(command -v fragpaper)"
elif [[ -f "$FRAGPAPER_SRC/target/release/fragpaper" ]]; then
    bin="$FRAGPAPER_SRC/target/release/fragpaper"
fi

if [[ -z "$bin" ]]; then
    echo "fragpaper-launch: no binary found" >&2
    exit 1
fi

# ── Theme ──────────────────────────────────────────────────────────────────
DOTFILES="${DOTFILES:-}"
if [[ -z "$DOTFILES" ]]; then
    for c in "$HOME/projects/dotfiles" "$HOME/dotfiles"; do
        [[ -d "$c/themes" ]] && DOTFILES="$c" && break
    done
    DOTFILES="${DOTFILES:-$HOME/projects/dotfiles}"
fi

BG_COLOR="#1a1b26"
PALETTE="dark"
ACTIVE_THEME_FILE="$HOME/.config/dotfiles/active-theme"
if [[ -f "$ACTIVE_THEME_FILE" ]]; then
    active=$(<"$ACTIVE_THEME_FILE")
    conf="$DOTFILES/themes/$active/fragpaper.conf"
    [[ -f "$conf" ]] && . "$conf"
fi

# ── Playlist (absolute paths) ──────────────────────────────────────────────
exec env RUST_LOG=info "$bin" \
    --bg-color "$BG_COLOR" \
    --palette "$PALETTE" \
    --playlist \
    "$FRAGPAPER_SRC/shaders/mandelbrot.frag:90" \
    "$FRAGPAPER_SRC/shaders/julia.frag:90" \
    "$FRAGPAPER_SRC/shaders/burningship.frag:60" \
    "$FRAGPAPER_SRC/shaders/clifford.frag:60" \
    "$FRAGPAPER_SRC/shaders/gradient.frag:60" \
    "$FRAGPAPER_SRC/shaders/waveform.frag:45" \
    "$FRAGPAPER_SRC/shaders/mist.frag:45" \
    ca:45 \
    coral:60 \
    highlife:45 \
    morley:45 \
    gliders:60 \
    glidersrandom:60 \
    rd:90 \
    lenia:60 \
    "$FRAGPAPER_SRC/shaders/attractors.vert:$FRAGPAPER_SRC/shaders/attractors.frag:90"
