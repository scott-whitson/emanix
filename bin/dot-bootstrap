#!/usr/bin/env bash
# bin/dot-bootstrap — pull latest dotfiles and run install
#
# Usage:
#   dot-bootstrap [--profile <name>] [--no-sync]
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$DOTFILES"

sync=1
profile_arg=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		--no-sync)
			sync=0
			shift
			;;
		--profile)
			[[ $# -ge 2 ]] || { echo "dot-bootstrap: --profile requires a value" >&2; exit 2; }
			profile_arg="$2"
			shift 2
			;;
		--profile=*)
			profile_arg="${1#*=}"
			shift
			;;
		"" )
			shift
			;;
		-h|--help)
			echo "Usage: dot-bootstrap [--profile <name>] [--no-sync]"
			exit 0
			;;
		*)
			echo "dot-bootstrap: unknown arg '${1}'" >&2
			echo "Usage: dot-bootstrap [--profile <name>] [--no-sync]" >&2
			exit 2
			;;
	esac
done

remote="$(git remote get-url origin 2>/dev/null || true)"
branch="$(git branch --show-current 2>/dev/null || true)"

if [[ -z "$remote" ]]; then
	printf '[dot-bootstrap] no git origin configured; skipping sync\n' >&2
	sync=0
fi

if [[ "$sync" -eq 1 ]]; then
	if [[ -z "$branch" ]]; then
		printf '[dot-bootstrap] cannot determine current branch; skipping sync\n' >&2
		sync=0
	else
		printf '==> git pull --ff-only %s %s\n' "$remote" "$branch"
		if ! git pull --ff-only "$remote" "$branch"; then
			exit 1
		fi
		printf '\n'
	fi
fi

if [[ ! -d "$HOME/lab" ]]; then
	printf '[dot-bootstrap] creating ~/lab for non-canonical checkouts\n' >&2
	mkdir -p "$HOME/lab"
fi

install_args=()
if [[ -n "$profile_arg" ]]; then
	install_args+=(--profile "$profile_arg")
fi

printf '==> ./install.sh\n'
exec "$DOTFILES/install.sh" "${install_args[@]}"
