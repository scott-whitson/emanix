#!/bin/bash
# fragpaper-ctl — control the fragpaper wallpaper service
# Usage: fragpaper-ctl [start|stop|restart|status|log]

set -u

case "${1:-status}" in
    start)
        systemctl --user start fragpaper.service
        echo "fragpaper started"
        ;;
    stop)
        systemctl --user stop fragpaper.service
        echo "fragpaper stopped"
        ;;
    restart)
        systemctl --user restart fragpaper.service
        sleep 2
        systemctl --user is-active fragpaper.service
        ;;
    status)
        systemctl --user status fragpaper.service --no-pager | head -12
        ;;
    log)
        journalctl --user -u fragpaper.service --no-pager -n 30 2>/dev/null
        ;;
    *)
        echo "Usage: fragpaper-ctl {start|stop|restart|status|log}"
        exit 1
        ;;
esac
