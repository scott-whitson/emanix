#!/usr/bin/env bash
# bin/dot-update — system update + dotfiles sync.
# Runs: apt update/full-upgrade, then dot-sync (git commit/pull/restow/push).
#
# BROKEN/SUPERSEDED (eminix convergence, 2026-08-07): all three hosts are
# NixOS now, so `apt` doesn't exist, and `bin/dot-sync` (git commit/pull/
# restow/push) was deleted with the stow retirement. The update path today
# is `nixos-rebuild switch --flake .#<host>` after a git pull; see
# installer/fresh-eminix-install / installer/eminix-firstboot for fresh
# installs. Left in place, unmodified below, for history.
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd)}"

echo "==> apt update && apt full-upgrade"
sudo apt update
sudo apt full-upgrade -y

echo ""
echo "==> dot-sync"
"$DOTFILES/bin/dot-sync"

echo ""
echo "==> dot-update complete"
