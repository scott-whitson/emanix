#!/usr/bin/env bash
# bin/dot-restow — re-stow one or all packages in base/
# Usage:
#   dot-restow <pkg>         # restow a specific package
#   dot-restow --all         # restow everything
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd)}"

restow_one() {
    local pkg="$1"
    if [[ -d "$DOTFILES/base/$pkg" ]]; then
        echo "[base] restowing $pkg"
        stow -d "$DOTFILES/base" -t "$HOME" --no-folding -R "$pkg"
    fi
}

case "${1:-}" in
    --all)
        # Conflicts must not starve later packages: on HM machines some
        # base/ packages are permanently HM-owned (ghostty), and apps like
        # pi replace their symlink with a real file — keep going, collect,
        # and report at the end. Exit 1 so dot-sync still surfaces it.
        failed=()
        for p in "$DOTFILES"/base/*/; do
            pkg="$(basename "$p")"
            restow_one "$pkg" || failed+=("$pkg")
        done
        if [[ ${#failed[@]} -gt 0 ]]; then
            echo "[base] conflicts (not re-linked): ${failed[*]}" >&2
            exit 1
        fi
        ;;
    ""|-h|--help)
        echo "Usage: dot-restow <pkg>|--all"
        exit 1
        ;;
    *)
        restow_one "$1"
        ;;
esac
